# C (in E) is placed in N1 at tick 1 and in the center at tick 2: two placed moves, one carried
# piston firing the tick it lands.
design designs/gadgets/center-return.txt
probe C0 0 0 0
probe N1 0 1 0
probe E 0 2 0
probe G 0 3 0
probe P2 1 2 0
setblock -1 5 -1 minecraft:redstone_block
setblock 3 4 -1 minecraft:redstone_block
setblock -1 3 0 minecraft:redstone_block
expect_trace N1 #
expect E .
expect C0 .
setblock 0 3 1 minecraft:redstone_block
setblock 0 3 2 minecraft:redstone_block
setblock 3 2 0 minecraft:redstone_block
expect_trace C0 #
expect N1 .
expect E ~
expect P2 .
expect_trace C0 ##
expect E r
