# Extend P (powered + updated by placing a block), take its power away silently, then flip M:
# D lights, its second-order update reaches P through K, and P retracts.
design designs/gadgets/dust-reach.txt
probe P 0 1 0
probe D 0 1 2
use 3 2 0
quiet 4
set -1 1 0 minecraft:stone
quiet 4
expect P E
use 3 2 0
quiet 4
expect P E
use 1 1 2
expect D 15
expect_trace P ~~r
