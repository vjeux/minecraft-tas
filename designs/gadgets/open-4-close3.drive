# open-4's machine closing in 3: as open-4-cycle.drive, but C's and T's carried-piston chains
# share tick 2. They are started at the same tick boundary and interleave in the FIFO block-event
# queue one event per chain per round, so T's chain is made longer: Y_P is fired by the update of
# a padding piston D1 (instead of directly) and 0-ticked by a partner in its quasi cell (X_YP3,
# one more event), which puts P_T's push one round after A' left T's cell. TL follows at k3.
design designs/gadgets/open-4.txt
probe TL 0 2 0
probe T 1 2 0
probe TR 2 2 0
probe ML 0 1 0
probe C 1 1 0
probe MR 2 1 0
probe BL 0 0 0
probe B 1 0 0
probe BR 2 0 0
probe E 1 3 0
# --- open (as open-4.drive)
setblock -1 3 1 minecraft:redstone_block
setblock -1 4 1 minecraft:redstone_block
setblock 2 4 1 minecraft:redstone_block
setblock 0 4 -1 minecraft:air
setblock 5 2 0 minecraft:air
setblock 5 1 0 minecraft:air
setblock 5 0 0 minecraft:air
setblock -3 1 0 minecraft:air
setblock -3 0 0 minecraft:air
setblock 1 -3 0 minecraft:air
quiet 3
setblock -2 3 1 minecraft:redstone_block
setblock -2 5 0 minecraft:redstone_block
setblock 1 7 0 minecraft:redstone_block
setblock 1 3 -3 minecraft:air
setblock -1 2 -3 minecraft:air
expect_trace T .
expect C .
quiet 6
# --- while open: disarm the four partners
setblock 2 4 1 minecraft:air
setblock 1 7 0 minecraft:air
setblock -1 4 1 minecraft:air
setblock -2 5 0 minecraft:air
setblock -1 3 2 minecraft:air
setblock 1 5 2 minecraft:air
setblock -2 3 2 minecraft:air
quiet 6
expect C .
expect T .
expect E #
# --- close, k0 (lever off): plain pullers powered again; F and G_T 0-ticks.
setblock 5 2 0 minecraft:redstone_block
setblock 5 1 0 minecraft:redstone_block
setblock 5 0 0 minecraft:redstone_block
setblock -3 1 0 minecraft:redstone_block
setblock -3 0 0 minecraft:redstone_block
setblock 1 -3 0 minecraft:redstone_block
setblock 2 6 -1 minecraft:redstone_block
setblock -3 4 -1 minecraft:redstone_block
setblock 2 4 0 minecraft:redstone_block
setblock -3 2 0 minecraft:redstone_block
expect_trace T #
expect TL #
expect E .
# k1 -> k2: both chains. Arming first (all silent): R_A3 + X_A for A', R_T4 + X_T for P_T,
# R_YP3 (quasi-powers Y_P through X_YP3's cell) + X_YP3, X_Y2. Then the triggers, A''s first:
# R_Y2 fires Y_A then X_Y2; the block under D1 fires D1, whose extension updates Y_P.
setblock 1 4 1 minecraft:redstone_block
setblock 1 4 2 minecraft:redstone_block
setblock -1 3 1 minecraft:redstone_block
setblock -1 4 1 minecraft:redstone_block
setblock -1 3 -3 minecraft:redstone_block
setblock -1 5 -2 minecraft:redstone_block
setblock 3 4 -1 minecraft:redstone_block
setblock 2 3 -2 minecraft:redstone_block
setblock -2 1 -2 minecraft:redstone_block
expect_trace C #
expect T #
expect TL .
expect TR ~
# k2 -> k3: TL's puller, quasi-armed through X_TL's cell, poked: TL home at k3 with the 6 plain
# pushes: every door cell holds its stone at k3.
setblock 0 5 -1 minecraft:redstone_block
setblock 0 7 0 minecraft:redstone_block
setblock 0 4 -1 minecraft:stone
expect_trace TL #
expect T #
expect TR #
expect ML #
expect C #
expect MR #
expect BL #
expect B #
expect BR #
quiet 6
expect TL #
expect T #
expect TR #
expect ML #
expect C #
expect MR #
expect BL #
expect B #
expect BR #
