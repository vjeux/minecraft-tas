# Both lever edges reach the repeater: the dust carries the 2gt observer pulse at t+2..t+3, the
# repeater is on t+10..t+17.
design designs/gadgets/pulse-bridge.txt
probe dust 0 1 3
probe rep 1 1 2
use 0 1 0
expect_trace dust 0++000
expect_trace rep 00011111111000
use 0 1 0
expect_trace dust 0++000
expect_trace rep 00011111111000
