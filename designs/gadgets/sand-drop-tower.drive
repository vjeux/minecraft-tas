# Collapse: R3 off, S2 off 4 gt later, S1 off 4 gt later; the sand ends 3 cells lower.
# Lift: S1, S2, R3 back on; the sand is back on top.
design designs/gadgets/sand-drop-tower.txt
probe top 1 8 1
probe bottom 1 3 1
probe R3 1 4 1
probe R3low 1 2 1
clear 2 4 1
step 4
clear 2 2 1
step 4
clear 0 0 0
quiet 30
expect top .
expect bottom #
expect R3low r
set 0 0 0 minecraft:redstone_block
step 4
set 2 2 1 minecraft:redstone_block
step 4
set 2 4 1 minecraft:redstone_block
quiet 10
expect top #
expect R3 E
