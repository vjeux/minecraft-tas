# Breaking the stone under scaffold A: A turns distance 1 one tick later, C above it one tick
# after that, the observer watching C pulses 2 gt later; placing it back reverses it.
design designs/gadgets/scaffold-delay.txt
probe A 0 1 0
probe C 0 2 0
probe O 0 3 0
clear 0 0 0
expect A 0
expect_trace A 1
expect C 0
expect_trace C 1
expect_trace O 0110
expect_state 0 1 0 bottom=true
set 0 0 0 minecraft:stone
expect_trace A 0
expect C 1
expect_trace C 0
expect_trace O 0110
