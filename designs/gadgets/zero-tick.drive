# 0-tick sticky piston: K is pushed AND placed in tick 1 (a plain push shows it moving for 2
# ticks: `~~#`); T is never seen extended, its base is moving (retracting) until tick 3.
design designs/gadgets/zero-tick.txt
probe T -1 1 0
probe K -1 1 -2
probe head -1 1 -1
probe X 0 1 -1
probe R 0 1 1
setblock 0 3 -1 minecraft:redstone_block
expect X r
setblock 0 1 0 minecraft:redstone_block
expect_trace K ###
expect T r
expect head .
expect X E
expect R R
