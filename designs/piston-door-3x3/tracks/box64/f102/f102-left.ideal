# right-side toggles + the left core's three trigger cells as ideal inputs
design designs/piston-door-3x3/tracks/box64/f102/f102-left.txt
let s1 = 0
let lv = 6
let lamp = 14
let s6 = 26
let tg = 36
open s1 set -2 4 0 minecraft:stone
open lv set -1 5 0 minecraft:air
open lv set -2 5 0 minecraft:redstone_block
open lv set -1 5 0 minecraft:redstone_wall_torch[facing=east,lit=true]
open lamp set -3 4 0 minecraft:redstone_block
open lamp+2 clear -3 4 0
open s6 clear -2 4 0
open tg set -2 -1 0 minecraft:redstone_block
open tg set 1 5 0 minecraft:redstone_block
open tg set 0 -2 0 minecraft:redstone_block
open tg set 3 -2 0 minecraft:redstone_block
open tg set 4 2 0 minecraft:redstone_block
open tg+2 clear -2 -1 0
open tg+2 clear 1 5 0
open tg+2 clear 0 -2 0
open tg+2 clear 3 -2 0
open tg+2 clear 4 2 0
close s1 set -2 4 0 minecraft:stone
close lv set -2 5 0 minecraft:smooth_stone
close lamp set -3 4 0 minecraft:redstone_block
close lamp+2 clear -3 4 0
close s6 clear -2 4 0
close tg set -2 -1 0 minecraft:redstone_block
close tg set 1 5 0 minecraft:redstone_block
close tg set 0 -2 0 minecraft:redstone_block
close tg set 3 -2 0 minecraft:redstone_block
close tg set 4 2 0 minecraft:redstone_block
close tg+2 clear -2 -1 0
close tg+2 clear 1 5 0
close tg+2 clear 0 -2 0
close tg+2 clear 3 -2 0
close tg+2 clear 4 2 0
