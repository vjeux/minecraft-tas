# families 8x8-102, in-plane ideal inputs emulating the planned wiring:
# L1 at rest from (-2,2) (also arms L0 by QC: L0 fires with L1 at s1 and s6, plus its own s7 = 3 pulses);
# PD held by QC from (-2,4) (torch), released at lv with a glass poke at (-1,4) (the torch's 2-level update);
# lifted L1 (s4) through the BL door block at (-1,0) (emulated by a redstone block in its place, open only).
design designs/piston-door-3x3/tracks/box64/f102/f102-mech.txt
let s1 = 0
let lv = 8
let s3 = 16
let s4 = 24
let s5 = 32
let s6 = 40
let s7 = 48
let tg = 56
open s1 set -2 2 0 minecraft:redstone_block
open s1+2 clear -2 2 0
open lv clear -2 4 0
open lv+1 set -1 4 0 minecraft:glass
open lv+2 clear -1 4 0
open s3 set -3 2 0 minecraft:redstone_block
open s3+2 clear -3 2 0
open s4 set -1 0 0 minecraft:redstone_block
open s4+2 set -1 0 0 minecraft:stone
open s5 set -3 2 0 minecraft:redstone_block
open s5+2 clear -3 2 0
open s6 set -2 2 0 minecraft:redstone_block
open s6+2 clear -2 2 0
open s7 set -2 -1 0 minecraft:redstone_block
open s7+2 clear -2 -1 0
open tg set 1 5 0 minecraft:redstone_block
open tg set 0 -2 0 minecraft:redstone_block
open tg set 3 -2 0 minecraft:redstone_block
open tg set 4 2 0 minecraft:redstone_block
open tg+2 clear 1 5 0
open tg+2 clear 0 -2 0
open tg+2 clear 3 -2 0
open tg+2 clear 4 2 0
close s1 set -2 2 0 minecraft:redstone_block
close s1+2 clear -2 2 0
close lv set -2 4 0 minecraft:redstone_block
close lv+1 set -1 4 0 minecraft:glass
close lv+2 clear -1 4 0
close s3 set -3 2 0 minecraft:redstone_block
close s3+2 clear -3 2 0
close s5 set -3 2 0 minecraft:redstone_block
close s5+2 clear -3 2 0
close s6 set -2 2 0 minecraft:redstone_block
close s6+2 clear -2 2 0
close s7 set -2 -1 0 minecraft:redstone_block
close s7+2 clear -2 -1 0
close tg set 1 5 0 minecraft:redstone_block
close tg set 0 -2 0 minecraft:redstone_block
close tg set 3 -2 0 minecraft:redstone_block
close tg set 4 2 0 minecraft:redstone_block
close tg+2 clear 1 5 0
close tg+2 clear 0 -2 0
close tg+2 clear 3 -2 0
close tg+2 clear 4 2 0
