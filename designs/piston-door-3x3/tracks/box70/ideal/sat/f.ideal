# m7 full (7x10): P_M, P_TL + left pair, P2 window (8 gt), P_M at (1,3) 2 gt after P2, P_M back,
# right pair at r (pulse; its observer below fires twice), bottom pullers at bl / bm / br.
design designs/piston-door-3x3/tracks/box70/ideal/sat/m7.txt
let p = 4
let a = 8
let r = 16
let bl = 26
let bm = 26
let br = 26
