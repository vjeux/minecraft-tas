# top half of m7 alone, P2 in toggle mode (two 2 gt pulses: push P_M down, pull it back)
design designs/piston-door-3x3/tracks/box70/ideal/sat/m7top2.txt
let p = 4
let a = 8
let g = 6
open 0 set 1 4 1 minecraft:redstone_block
open 2 clear 1 4 1
open p set -1 3 1 minecraft:redstone_block
open p set -2 1 1 minecraft:redstone_block
open p set -2 2 1 minecraft:redstone_block
open p+2 clear -1 3 1
open p+2 clear -2 1 1
open p+2 clear -2 2 1
open a set 1 5 1 minecraft:redstone_block
open a+2 clear 1 5 1
open a+2 set 1 3 1 minecraft:redstone_block
open a+4 clear 1 3 1
open a+g set 1 5 1 minecraft:redstone_block
open a+g+2 clear 1 5 1
open a+g+4 set 1 4 1 minecraft:redstone_block
open a+g+6 clear 1 4 1
close 0 set 1 4 1 minecraft:redstone_block
close 2 clear 1 4 1
close p set -1 3 1 minecraft:redstone_block
close p set -2 1 1 minecraft:redstone_block
close p set -2 2 1 minecraft:redstone_block
close p+2 clear -1 3 1
close p+2 clear -2 1 1
close p+2 clear -2 2 1
close a set 1 5 1 minecraft:redstone_block
close a+2 clear 1 5 1
close a+2 set 1 3 1 minecraft:redstone_block
close a+4 clear 1 3 1
close a+g set 1 5 1 minecraft:redstone_block
close a+g+2 clear 1 5 1
close a+g+4 set 1 4 1 minecraft:redstone_block
close a+g+6 clear 1 4 1
