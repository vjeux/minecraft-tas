# c077 with every event its own variable
let bl1 = 0
let bl2 = 6
let bl3 = 30
let cbl1 = 0
let cbl2 = 12
let ml1 = 0
let ml2 = 30
let cml = 12
let p3a = 12
let p3b = 24
let p1c = 18
open 0 use 1 5 0
open bl1 set -2 -1 0 minecraft:redstone_block
open bl1+2 clear -2 -1 0
open bl2 set -2 -1 0 minecraft:redstone_block
open bl2+2 clear -2 -1 0
open bl3 set -2 -1 0 minecraft:redstone_block
open bl3+2 clear -2 -1 0
open ml1 set -2 1 1 minecraft:redstone_block
open ml1+2 clear -2 1 1
open ml2 set -2 1 1 minecraft:redstone_block
open ml2+2 clear -2 1 1
open p3a set -4 1 0 minecraft:redstone_block
open p3a+2 clear -4 1 0
open p3b set -4 1 0 minecraft:redstone_block
open p3b+2 clear -4 1 0
open p1c set -1 1 1 minecraft:redstone_block
open p1c+2 clear -1 1 1
close 0 use 1 5 0
close cbl1 set -2 -1 0 minecraft:redstone_block
close cbl1+2 clear -2 -1 0
close cbl2 set -2 -1 0 minecraft:redstone_block
close cbl2+2 clear -2 -1 0
close cml set -2 1 1 minecraft:redstone_block
close cml+2 clear -2 1 1
let b = 20
open b set 1 -2 1 minecraft:redstone_block
open b+2 clear 1 -2 1
close b set 1 -2 1 minecraft:redstone_block
close b+2 clear 1 -2 1
