# c077 with every event its own variable
let bl1 = 0
let bl2 = 6
let bl3 = 30
let cbl1 = 0
let cbl2 = 12
let ml1 = 0
let ml2 = 30
let cml = 12
let tl = 6
let ctl = 6
let p3a = 12
let p3b = 24
let p1c = 18
let z = 30
let cz = 18
let zr = 30
let czr = 18
let zb = 30
let czb = 18
open 0 use 1 5 0
open bl1 set -2 -1 0 minecraft:redstone_block
