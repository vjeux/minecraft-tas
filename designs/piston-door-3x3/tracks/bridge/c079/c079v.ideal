# c079 with every event its own variable (open / close)
let p1a = 0
let cp1a = 0
let p1b = 30
let cp1b = 12
let p2 = 6
let cp2 = 6
let p3a = 12
let p3b = 24
let p1c = 18
let zb = 30
let czb = 12
let zr = 30
let czr = 12
open 0 use 1 5 0
open p1a set -2 1 1 minecraft:redstone_block
open p1a+2 clear -2 1 1
open p2 set -2 -1 0 minecraft:redstone_block
open p2+2 clear -2 -1 0
open p3a set -3 0 0 minecraft:redstone_block
open p3a+2 clear -3 0 0
open p1c set -1 1 1 minecraft:redstone_block
open p1c+2 clear -1 1 1
open p3b set -3 0 0 minecraft:redstone_block
open p3b+2 clear -3 0 0
open p1b set -2 1 1 minecraft:redstone_block
open p1b+2 clear -2 1 1
open zb set 0 -3 0 minecraft:redstone_block
open zb set 1 -3 0 minecraft:redstone_block
open zb set 2 -3 0 minecraft:redstone_block
open zb+2 clear 0 -3 0
open zb+2 clear 1 -3 0
open zb+2 clear 2 -3 0
open zr set 4 0 0 minecraft:redstone_block
open zr+2 clear 4 0 0
close 0 use 1 5 0
close cp1a set -2 1 1 minecraft:redstone_block
close cp1a+2 clear -2 1 1
close cp2 set -2 -1 0 minecraft:redstone_block
close cp2+2 clear -2 -1 0
close cp1b set -2 1 1 minecraft:redstone_block
close cp1b+2 clear -2 1 1
close czb set 0 -3 0 minecraft:redstone_block
close czb set 1 -3 0 minecraft:redstone_block
close czb set 2 -3 0 minecraft:redstone_block
close czb+2 clear 0 -3 0
close czb+2 clear 1 -3 0
close czb+2 clear 2 -3 0
close czr set 4 0 0 minecraft:redstone_block
close czr+2 clear 4 0 0
