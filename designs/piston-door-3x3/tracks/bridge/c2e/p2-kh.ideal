design designs/piston-door-3x3/tracks/bridge/c2e/p2.txt
# p2 with K as a hold of length kl (open k, close ck)
let k = 18
let ck = 18
let kl = 10
let ckl = 10
open 0 use -2 6 0
close 0 use -2 6 0
open k set 3 -1 1 minecraft:redstone_block
open k+kl clear 3 -1 1
close ck set 3 -1 1 minecraft:redstone_block
close ck+ckl clear 3 -1 1
