# ceil c035: families 7x8-035 (BR DOWN by SU(2,-2), MR right, ML+BL left, BM to the left floor
# corner by SE(-1,-1), C down 2 by the A (1,-2) / B (1,-3) elevator) with the e88 ceiling-held top:
# lever ON at rest on the TM puller (1,4) holds the three ceiling pullers (TM direct, TL/TR by QC).
# Static frame stones (-1,2) (3,2) (3,0). Everything else ideal (7x8-035-oc's plan, top inputs removed).
let w = 0
let pm = 6
let b1 = 12
let a1 = 18
let b2 = 24
let z = 30
let zc = 12
open 0 use 1 5 0
open w set -3 1 0 minecraft:redstone_block
open w set -3 0 0 minecraft:redstone_block
open w set 0 -2 0 minecraft:redstone_block
open w+2 clear -3 1 0
open w+2 clear -3 0 0
open w+2 clear 0 -2 0
open pm set -1 -2 0 minecraft:redstone_block
open pm+2 clear -1 -2 0
open b1 set 1 -4 0 minecraft:redstone_block
open b1+2 clear 1 -4 0
open a1 set 1 -1 1 minecraft:redstone_block
open a1+2 clear 1 -1 1
open b2 set 1 -4 0 minecraft:redstone_block
open b2+2 clear 1 -4 0
open z set 0 -2 0 minecraft:redstone_block
open z set 3 -2 0 minecraft:redstone_block
open z set 4 0 0 minecraft:redstone_block
open z+2 clear 0 -2 0
open z+2 clear 3 -2 0
open z+2 clear 4 0 0
close 0 use 1 5 0
close w set -3 1 0 minecraft:redstone_block
close w set -3 0 0 minecraft:redstone_block
close w set 0 -2 0 minecraft:redstone_block
close w+2 clear -3 1 0
close w+2 clear -3 0 0
close w+2 clear 0 -2 0
close pm set -1 -2 0 minecraft:redstone_block
close pm+2 clear -1 -2 0
close zc set 0 -2 0 minecraft:redstone_block
close zc set 3 -2 0 minecraft:redstone_block
close zc set 4 0 0 minecraft:redstone_block
close zc+2 clear 0 -2 0
close zc+2 clear 3 -2 0
close zc+2 clear 4 0 0
