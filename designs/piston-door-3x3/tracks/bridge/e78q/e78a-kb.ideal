# e78a with the two bottom sensors replaced by ideal 10 gt holds (K at kh, B' at bh)
let kh = 9
let bh = 9
let ckh = 9
let cbh = 9
open 0 use 1 5 0
close 0 use 1 5 0
open kh set 3 -1 1 minecraft:redstone_block
open kh+10 clear 3 -1 1
open bh set 1 -3 1 minecraft:redstone_block
open bh+10 clear 1 -3 1
close ckh set 3 -1 1 minecraft:redstone_block
close ckh+10 clear 3 -1 1
close cbh set 1 -3 1 minecraft:redstone_block
close cbh+10 clear 1 -3 1
