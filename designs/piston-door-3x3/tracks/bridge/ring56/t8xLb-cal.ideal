# t8xL-b with A driven like an observer on a CALIBRATED sensor (taps a1, a1+10, a1+20) and B's pair b1, b1+bd.
let a1 = 6
let b1 = 18
let bd = 12
let u = 42
open 0 use 6 1 0
close 0 use 6 1 0
open a1 set 1 4 1 minecraft:redstone_block
open a1+2 clear 1 4 1
open b1 set 1 5 1 minecraft:redstone_block
open b1+2 clear 1 5 1
open a1+10 set 1 3 1 minecraft:redstone_block
open a1+12 clear 1 3 1
open b1+bd set 1 5 1 minecraft:redstone_block
open b1+bd+2 clear 1 5 1
open a1+20 set 1 4 1 minecraft:redstone_block
open a1+22 clear 1 4 1
open u set 1 -2 1 minecraft:redstone_block
open u+2 clear 1 -2 1
close a1 set 1 4 1 minecraft:redstone_block
close a1+2 clear 1 4 1
close b1 set 1 5 1 minecraft:redstone_block
close b1+2 clear 1 5 1
close a1+10 set 1 3 1 minecraft:redstone_block
close a1+12 clear 1 3 1
close b1+bd set 1 5 1 minecraft:redstone_block
close b1+bd+2 clear 1 5 1
close a1+20 set 1 4 1 minecraft:redstone_block
close a1+22 clear 1 4 1
close u set 1 -2 1 minecraft:redstone_block
close u+2 clear 1 -2 1
