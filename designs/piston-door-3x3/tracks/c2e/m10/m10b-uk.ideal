# m10b-uk: the whole bottom real except L0: BR observer (4,-1) on R0 -> lamp (4,-2) -> observer (3,-2) -> stone (2,-2): U at 5 and 11 (lamp off-edge); obsidian (3,-1) stops a late K push; BL observer (0,-2) watching U -> observer (-1,-2) -> stone (-2,-2) -> dust (-2,-1) -> K at 9 (U + 4: after BM, pulled down by U, has landed). Top ideal (A hold 7..8, A last pull, L1/L2), L0 ideal.
design designs/piston-door-3x3/tracks/c2e/m10/m10b-uk.txt
let ah0 = 8
let ah = 4
let l12 = 20
let af = 20
let l0 = 11
open 0 use 4 5 0
open ah0 set 1 3 -1 minecraft:redstone_block
open ah0+ah clear 1 3 -1
open l12 set -2 2 -1 minecraft:redstone_block
open l12+2 clear -2 2 -1
open af set 1 4 -1 minecraft:redstone_block
open af+2 clear 1 4 -1
open l0 set -2 0 -1 minecraft:redstone_block
open l0+2 clear -2 0 -1
close 0 use 4 5 0
close 0 set -2 2 -1 minecraft:redstone_block
close 2 clear -2 2 -1
close l0 set -2 0 -1 minecraft:redstone_block
close l0+2 clear -2 0 -1
