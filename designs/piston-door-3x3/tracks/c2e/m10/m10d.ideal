# m10d = m10top's m10b top (B watcher: A's last pull + L1/L2 real) + c2e's bottom (U twice + K real), B's repeater
# (2,5) d4; only A's hold and L0 ideal.
design designs/piston-door-3x3/tracks/c2e/m10/m10d.txt
let ah0 = 8
let ah = 4
let l0 = 11
open 0 use 4 5 0
open ah0 set 1 3 -1 minecraft:redstone_block
open ah0+ah clear 1 3 -1
open l0 set -2 0 -1 minecraft:redstone_block
open l0+2 clear -2 0 -1
close 0 use 4 5 0
close l0 set -2 0 -1 minecraft:redstone_block
close l0+2 clear -2 0 -1
