open oa3+2 clear 1 4 1
open or set 3 4 0 minecraft:redstone_block
open or+2 clear 3 4 0
open om set 5 1 0 minecraft:redstone_block
open om+2 clear 5 1 0
open on set 4 -1 0 minecraft:redstone_block
open on+2 clear 4 -1 0
close cse set -3 2 0 minecraft:redstone_block
close cse set -2 0 0 minecraft:redstone_block
close cse+2 clear -3 2 0
