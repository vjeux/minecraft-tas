# 7x8-t1-001 (mechspace) oc plan with every event on its own variable (o* = open, c* = close), for
# window sweeps: se = SE(-2,2)+SE(-2,1) pulse, bl = SU+(0,-2) level (off on open, on on close),
# bm = SU(1,-2) pulse, a1/a2/a3 = SD(1,4) pulses (a2 at (1,3) on open), t = SE(-1,3) pulse,
# b1/b2 = SD(1,5) pulses (open only), r = SD(2,4) pulse, m = SW(4,1) pulse, n = SW(4,0) pulse.
design designs/piston-door-3x3/tracks/c2e/t1/t1-001-oc-f.txt
let ose = 0
let obl = 6
let obm = 12
let oa1 = 12
let ot = 18
let ob1 = 24
let oa2 = 30
let ob2 = 36
let oa3 = 42
let or = 42
let om = 42
let on = 42
let cse = 0
let cbl = 6
let cbm = 12
let ca1 = 12
let ct = 18
let ca2 = 24
let cr = 24
let cm = 24
let cn = 24
open ose set -3 2 0 minecraft:redstone_block
open ose set -2 0 0 minecraft:redstone_block
