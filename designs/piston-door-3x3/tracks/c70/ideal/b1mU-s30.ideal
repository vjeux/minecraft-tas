# c70: b1mU with M as an ideal redstone block behind (-1,1) (tile phase), U by the test observer X (glass toggle at gu)
design designs/piston-door-3x3/tracks/c70/wip/b1mU-s30.txt
let gu = 12
let m = 17
let mc = 30
let ml = 2
open 0 use 1 5 0
open gu set -1 -1 2 minecraft:glass
open m set -1 1 1 minecraft:redstone_block
open m+ml clear -1 1 1
open 40 set 0 -2 1 minecraft:redstone_block
open 42 clear 0 -2 1
open 40 set 1 -2 1 minecraft:redstone_block
open 42 clear 1 -2 1
close 0 use 1 5 0
close gu clear -1 -1 2
close mc set -1 1 1 minecraft:redstone_block
close mc+2 clear -1 1 1
close 40 set 0 -2 1 minecraft:redstone_block
close 42 clear 0 -2 1
close 40 set 1 -2 1 minecraft:redstone_block
close 42 clear 1 -2 1
