# c70 h1: b1mU + D held 30 gt by a plain sensor (-3,0) under D (hears the lever t6; the watcher (-2,0) only nudges D)
# E chain: plain sensor (-2,4) watched by observer (-2,3) facing up (QC + update of E through (-2,2)): taps t5, t35, t45
# U by the test observer X (glass toggle at gu / guc), M (E at (-1,1)) ideal redstone block m..m+2, mc on close
design designs/piston-door-3x3/tracks/c70/wip/h1.txt
let gu = 8
let guc = 8
let m = 16
let mc = 30
open 0 use 1 5 0
open gu set -1 -1 2 minecraft:glass
open m set -1 1 1 minecraft:redstone_block
open m+2 clear -1 1 1
open 50 set 0 -2 1 minecraft:redstone_block
open 52 clear 0 -2 1
open 50 set 1 -2 1 minecraft:redstone_block
open 52 clear 1 -2 1
close 0 use 1 5 0
close guc clear -1 -1 2
close mc set -1 1 1 minecraft:redstone_block
close mc+2 clear -1 1 1
close 50 set 0 -2 1 minecraft:redstone_block
close 52 clear 0 -2 1
close 50 set 1 -2 1 minecraft:redstone_block
close 52 clear 1 -2 1
