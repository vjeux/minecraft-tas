# c70b t8b: t8a + the real gate observer (0,-2) facing down; the plan toggles its watched cell (0,-3) (glass) at gs1 / gs2 on both edges
design designs/piston-door-3x3/tracks/c70b/t7b/t8b.txt
let pm = 21
let b = 27
let bw = 8
let gs1 = 27
let gs2 = 35
open 0 use 1 5 0
close 0 use 1 5 0
open pm set -1 -1 1 minecraft:redstone_block
open pm+2 clear -1 -1 1
close pm set -1 -1 1 minecraft:redstone_block
close pm+2 clear -1 -1 1
open b set 1 -3 1 minecraft:redstone_block
open b+bw clear 1 -3 1
close b set 1 -3 1 minecraft:redstone_block
close b+bw clear 1 -3 1
open gs1 set 0 -3 0 minecraft:glass
open gs2 clear 0 -3 0
close gs1 set 0 -3 0 minecraft:glass
close gs2 clear 0 -3 0
