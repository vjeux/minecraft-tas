# c70b t8r2: hybrid B: an ideal east pulse at b (redstone block at (2,-3,1)? no: behind B' (1,-3,1)) lifts A', then the R shuttle (X (-2,-3) pushes R into (0,-3) at sr, pulls it back at sr2) holds B' and the real gate sees R arrive / leave
design designs/piston-door-3x3/tracks/c70b/t7b/t8r.txt
let pm = 21
let b = 25
let sr = 27
let sr2 = 35
open 0 use 1 5 0
close 0 use 1 5 0
open pm set -1 -1 1 minecraft:redstone_block
open pm+2 clear -1 -1 1
close pm set -1 -1 1 minecraft:redstone_block
close pm+2 clear -1 -1 1
open b set 1 -3 1 minecraft:redstone_block
open b+2 clear 1 -3 1
close b set 1 -3 1 minecraft:redstone_block
close b+2 clear 1 -3 1
open sr set -2 -3 1 minecraft:redstone_block
open sr+2 clear -2 -3 1
open sr2 set -2 -3 1 minecraft:redstone_block
open sr2+2 clear -2 -3 1
close sr set -2 -3 1 minecraft:redstone_block
close sr+2 clear -2 -3 1
close sr2 set -2 -3 1 minecraft:redstone_block
close sr2+2 clear -2 -3 1
