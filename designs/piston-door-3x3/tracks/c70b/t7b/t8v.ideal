# c70b t8v: B by a static observer V0 (0,-3) facing west (output into B'), the plan toggles its watched cell (-1,-3) at gv1 (set) / gv2 (clear); the real gate (0,-2) watches V0
design designs/piston-door-3x3/tracks/c70b/t7b/t8v.txt
let pm = 12
let gv1 = 16
let gv2 = 22
open 0 use 1 5 0
close 0 use 1 5 0
open pm set -1 -1 1 minecraft:redstone_block
open pm+2 clear -1 -1 1
close pm set -1 -1 1 minecraft:redstone_block
close pm+2 clear -1 -1 1
open gv1 set -1 -3 0 minecraft:glass
open gv2 clear -1 -3 0
close gv1 set -1 -3 0 minecraft:glass
close gv2 clear -1 -3 0
