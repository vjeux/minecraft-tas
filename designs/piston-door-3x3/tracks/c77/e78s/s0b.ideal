# S0 (0,-3) removed: B' (1,-3) held by the plan [b, b+bl) on both edges (cb/cbl on close)
let b = 34
let bl = 11
let cb = b
let cbl = bl
open 0 use 1 5 0
close 0 use 1 5 0
open b set 1 -3 1 minecraft:redstone_block
open b+bl clear 1 -3 1
close cb set 1 -3 1 minecraft:redstone_block
close cb+cbl clear 1 -3 1
