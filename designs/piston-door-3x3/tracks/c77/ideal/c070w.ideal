# ceil c070w: c070 with the real top, t7b's right chain (MR+BR) and the TL-watcher chain into E
# (E1 real at ~t7). Assisted: U (-1,-1), D (-3,1), M (E moved to (-1,1)), E2, BL/BM down.
design designs/piston-door-3x3/tracks/c77/wip/c070w.txt
let u = 13
let d1 = 19
let m = 25
let d2 = 31
let e2 = 37
let bl = 40
let bm = 40
let uc = 13
let e2c = 20
let blc = 20
let bmc = 20
