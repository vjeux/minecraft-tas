# ceil c074g: c074 + an observer (-2,2) facing west (the ML gate: powers (-1,2), where ML parks while
# open). Its watched cell (-3,2) is toggled by the plan on BOTH edges at gm-2 and ge-2 (two pulses):
# M (E at (-1,1)) and E2 (E at (-2,1), QC through (-2,2)) should fire on OPEN only.
design designs/piston-door-3x3/tracks/c77/wip/c074g.txt
let e1 = 4
let s = 10
let d1 = 16
let d2 = 28
let gm = 22
let ge = 34
let r = 8
let bl = 20
let bm = 20
open 0 use 1 5 0
open e1 set -2 1 1 minecraft:redstone_block
open e1+2 clear -2 1 1
open s set -1 3 1 minecraft:redstone_block
open s+2 clear -1 3 1
open d1 set -3 1 1 minecraft:redstone_block
open d1+2 clear -3 1 1
open d2 set -3 1 1 minecraft:redstone_block
open d2+2 clear -3 1 1
open gm-2 set -3 2 0 minecraft:glass
open ge-2 clear -3 2 0
open r set 4 1 1 minecraft:redstone_block
open r set 4 0 1 minecraft:redstone_block
open r+2 clear 4 1 1
open r+2 clear 4 0 1
open bl set 0 -2 1 minecraft:redstone_block
open bl+2 clear 0 -2 1
open bm set 1 -2 1 minecraft:redstone_block
open bm+2 clear 1 -2 1
close 0 use 1 5 0
close e1 set -2 1 1 minecraft:redstone_block
close e1+2 clear -2 1 1
close s set -1 3 1 minecraft:redstone_block
close s+2 clear -1 3 1
close d1 set -3 1 1 minecraft:redstone_block
close d1+2 clear -3 1 1
close d2 set -3 1 1 minecraft:redstone_block
close d2+2 clear -3 1 1
close gm-2 set -3 2 0 minecraft:glass
close ge-2 clear -3 2 0
close r set 4 1 1 minecraft:redstone_block
close r set 4 0 1 minecraft:redstone_block
close r+2 clear 4 1 1
close r+2 clear 4 0 1
close bl set 0 -2 1 minecraft:redstone_block
close bl+2 clear 0 -2 1
close bm set 1 -2 1 minecraft:redstone_block
close bm+2 clear 1 -2 1
