# symmetric bottom with free pulse widths: U (a, wa), K (b, wk), U (c, wc), L0 at 12, both edges
design designs/piston-door-3x3/tracks/c88/s1.txt
let a = 12
let b = 16
let c = 20
let wa = 2
let wk = 2
let wc = 2
open 0 use 4 6 0
open a set 1 -2 -1 minecraft:redstone_block
open a+wa clear 1 -2 -1
open b set -1 -1 -1 minecraft:redstone_block
open b+wk clear -1 -1 -1
open c set 1 -2 -1 minecraft:redstone_block
open c+wc clear 1 -2 -1
open 12 set -2 0 -1 minecraft:redstone_block
open 14 clear -2 0 -1
close 0 use 4 6 0
close a set 1 -2 -1 minecraft:redstone_block
close a+wa clear 1 -2 -1
close b set -1 -1 -1 minecraft:redstone_block
close b+wk clear -1 -1 -1
close c set 1 -2 -1 minecraft:redstone_block
close c+wc clear 1 -2 -1
close 12 set -2 0 -1 minecraft:redstone_block
close 14 clear -2 0 -1
