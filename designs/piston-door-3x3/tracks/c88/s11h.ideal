# s10: s9 + K real and LEVEL-held: dust (-3,0) under the lever block -> stone (-3,-1) -> repeater
# (-2,-1) facing west, delay 4 -> K (extended at rest, head (0,-1)): K moves 8 gt after each flip.
# s11: s10 + U real: dropper (-3,-2) (lever level) -> observer (-2,-2) -> dropper (-1,-2) (also
# quasi-powered by K's repeater through K) -> observer (0,-2) -> U. On close the early pulse passes
# (U1, then U2 when K's level lands); on open the dropper is still held by K's level, so only U2.
# Obsidian (3,-1) blocks K's early push on close. A, B, right side ideal.
design designs/piston-door-3x3/tracks/c88/s11.txt
let r = 30
let b = 30
let u1 = 3
let u2 = 12
let ap = 3
let ah = 4
let bb = 20
let atp = bb+4
let bw = 2
let hz = 0
open 0 use -4 1 0
open ap set 1 3 -1 minecraft:redstone_block
open ap+ah clear 1 3 -1
open bb set 1 5 -1 minecraft:redstone_block
open bb+bw clear 1 5 -1
open atp set 1 4 -1 minecraft:redstone_block
open atp+2 clear 1 4 -1
open r set 4 2 -1 minecraft:redstone_block
open r+2 clear 4 2 -1
open b set 2 -2 -1 minecraft:redstone_block
open b+2 clear 2 -2 -1
close 0 use -4 1 0
close bb set 1 5 -1 minecraft:redstone_block
close bb+bw clear 1 5 -1
close atp+hz set 1 3 -1 minecraft:redstone_block
close atp+hz+2 clear 1 3 -1
close r set 4 2 -1 minecraft:redstone_block
close r+2 clear 4 2 -1
close b set 2 -2 -1 minecraft:redstone_block
close b+2 clear 2 -2 -1
