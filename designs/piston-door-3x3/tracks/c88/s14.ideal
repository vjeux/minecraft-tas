# s14: s11 (real bottom/left) with B LEVEL-held again (extended at rest; ideal level = redstone block
# (0,5), cleared on open at bb, set on close at bb), so B moves once per edge (one B-watcher pulse).
# A push+hold (ap, ah), A's top pull (atp, open) + its close hazard (hz), right side ideal.
design designs/piston-door-3x3/tracks/c88/s14.txt
let r = 30
let b = 30
let ap = 1
let ah = 4
let bb = 9
let atp = 11
let hz = 0
open 0 use -4 1 0
open ap set 1 3 -1 minecraft:redstone_block
open ap+ah clear 1 3 -1
open bb clear 0 5 0
open atp set 1 4 -1 minecraft:redstone_block
open atp+2 clear 1 4 -1
open r set 4 2 -1 minecraft:redstone_block
open r+2 clear 4 2 -1
open b set 2 -2 -1 minecraft:redstone_block
open b+2 clear 2 -2 -1
close 0 use -4 1 0
close bb set 0 5 0 minecraft:redstone_block
close atp+hz set 1 3 -1 minecraft:redstone_block
close atp+hz+2 clear 1 3 -1
close r set 4 2 -1 minecraft:redstone_block
close r+2 clear 4 2 -1
close b set 2 -2 -1 minecraft:redstone_block
close b+2 clear 2 -2 -1
