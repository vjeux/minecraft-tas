# s17: s11 + A's push+hold REAL from the left: observer (-1,3) facing down on TL's park (the park
# changes at t1 on both edges -> pulse t3-5) -> dust (-1,4) (0,4) on the static (0,3) -> A at (1,3)
# (open push) / A at (1,4) (close push); observer (-3,3) on the TL dust -> dropper (-3,4) -> observer
# (-2,4) -> the same dust line t4-6 (hold): A powered t3-6. B (pulse bb), A's top pull (atp) + its
# close hazard (hz), right side still ideal.
design designs/piston-door-3x3/tracks/c88/s17.txt
let r = 30
let b = 30
let bb = 8
let atp = 12
let bw = 2
let hz = 0
open 0 use -4 1 0
open bb set 1 5 -1 minecraft:redstone_block
