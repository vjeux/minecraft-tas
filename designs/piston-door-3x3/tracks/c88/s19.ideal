# s19: s11 + B REAL: pockets' top-left find (explore/pockets runs/s11-tl-k5 pocket0-set0): note block
# (-1,3) over TL's park (its instrument flips when TL lands there on open, t3, or leaves on close, t1)
# -> observers (-1,4) (-1,5) facing down -> observer (0,5) facing west -> B, a 2-gt pulse at t9 on open
# (lifts A at t11-13) and t7 on close. Still ideal: A push+hold (ap, ah), A's top pull (atp, open), the
# right pullers (r) and BR's puller (b).
design designs/piston-door-3x3/tracks/c88/s19.txt
let r = 30
let b = 30
let ap = 3
let ah = 4
let atp = 24
open 0 use -4 1 0
open ap set 1 3 -1 minecraft:redstone_block
open ap+ah clear 1 3 -1
open atp set 1 4 -1 minecraft:redstone_block
open atp+2 clear 1 4 -1
open r set 4 2 -1 minecraft:redstone_block
open r+2 clear 4 2 -1
open b set 2 -2 -1 minecraft:redstone_block
open b+2 clear 2 -2 -1
close 0 use -4 1 0
close r set 4 2 -1 minecraft:redstone_block
close r+2 clear 4 2 -1
close b set 2 -2 -1 minecraft:redstone_block
close b+2 clear 2 -2 -1
