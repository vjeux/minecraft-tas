# s21: s11 + pockets2's A push (observer (-3,3) down on the lever's dust -> dust (-3,4), (-2,4) -> lamp
# (-2,3) -> observer (-1,3) west into the static (0,3): A at t4 and again at t10 when the lamp goes
# dark, both edges). Still ideal: B (pulse bo open / bc close, width bw), A's top pull (atp/atc), R, BR.
design designs/piston-door-3x3/tracks/c88/s21.txt
let r = 30
let b = 30
let bo = 16
let bc = 16
let bw = 2
let atp = 24
let atc = 24
open 0 use -4 1 0
open bo set 1 5 -1 minecraft:redstone_block
open bo+bw clear 1 5 -1
open atp set 1 4 -1 minecraft:redstone_block
open atp+2 clear 1 4 -1
open r set 4 2 -1 minecraft:redstone_block
open r+2 clear 4 2 -1
open b set 2 -2 -1 minecraft:redstone_block
open b+2 clear 2 -2 -1
close 0 use -4 1 0
close bc set 1 5 -1 minecraft:redstone_block
close bc+bw clear 1 5 -1
close atc set 1 4 -1 minecraft:redstone_block
close atc+2 clear 1 4 -1
close r set 4 2 -1 minecraft:redstone_block
close r+2 clear 4 2 -1
close b set 2 -2 -1 minecraft:redstone_block
close b+2 clear 2 -2 -1
