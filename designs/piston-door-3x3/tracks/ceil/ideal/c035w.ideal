# ceil c035w: c035 with the real top (lever on the TM puller) and t7b's wall wiring (TL/TR park
# watchers -> repeater -> observer up -> ML+BL / MR pullers). Bottom ideal: A (1,-2), B (1,-3),
# P_M (-1,-1), BR's down-puller SU(2,-2).
design designs/piston-door-3x3/tracks/ceil/wip/c035w.txt
let w = 0
let pm = 6
let b1 = 12
let a1 = 18
let b2 = 24
let z = 30
let br = 30
let zc = 12
let brc = 12
open 0 use 1 5 0
