# ceil c074d: c074 (ML up into (-1,2) by the corner SD(-1,3)) with D tapped on BOTH edges and M + E2 on
# OPEN only: ML parked at (-1,2) gates both (a source at (-2,2) powering (-1,2) reaches E at (-1,1)
# directly = M, and E at (-2,1) by QC through (-2,2) = E2). Everything ideal except the ceiling.
design designs/piston-door-3x3/tracks/ceil/wip/c074.txt
let e1 = 4
let s = 10
let d1 = 16
let m = 22
let d2 = 28
let e2 = 34
let r = 8
let bl = 20
let bm = 20
open 0 use 1 5 0
open e1 set -2 1 1 minecraft:redstone_block
