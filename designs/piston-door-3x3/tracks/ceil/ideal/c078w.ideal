# ceil c078w: families 8x7-078 (= c077 with the ML-up corner piston SD+(-1,3) EXTENDED at rest: a
# level-held S, released on open, re-engaged on close) + ceiling + c077w's real parts (ML-park watcher
# (-2,2) east -> stone (-3,2) on D; E observer (-2,3) up; M-gate observer (-1,-1) down).
# S's level is an ideal redstone block (-1,3,1) (present at rest): cleared at sr on open, set at src
# on close. Other inputs ideal, both edges.
design designs/piston-door-3x3/tracks/ceil/wip/c078w.txt
let bl = 2
let e1 = 4
let sr = 10
let src = 10
let gm = 14
let e2 = 40
let e2c = 40
let bm = 20
let r = 8
open 0 use 1 5 0
open bl set -2 -1 0 minecraft:redstone_block
open bl+2 clear -2 -1 0
open e1-2 set -2 4 0 minecraft:glass
open sr clear -1 3 1
open gm-2 set -1 -2 0 minecraft:glass
open e2-2 clear -2 4 0
open bm set 1 -2 1 minecraft:redstone_block
open bm+2 clear 1 -2 1
open r set 4 1 1 minecraft:redstone_block
open r set 4 0 1 minecraft:redstone_block
open r+2 clear 4 1 1
open r+2 clear 4 0 1
close 0 use 1 5 0
close bl set -2 -1 0 minecraft:redstone_block
close bl+2 clear -2 -1 0
close e1-2 set -2 4 0 minecraft:glass
close src set -1 3 1 minecraft:redstone_block
close gm-2 clear -1 -2 0
close e2c-2 clear -2 4 0
close bm set 1 -2 1 minecraft:redstone_block
close bm+2 clear 1 -2 1
close r set 4 1 1 minecraft:redstone_block
close r set 4 0 1 minecraft:redstone_block
close r+2 clear 4 1 1
close r+2 clear 4 0 1
