# wire56 t1: K2 (controller) emulated by redstone blocks one cell behind the plane (z=1, so they
# power only the piston in front, and its QC as a real feed would); K1/K0/K3 are real (t1.txt).
# An observer pulse [T, T+2) is emulated by `set` at T-1 and `clear` at T+1.
design designs/piston-door-3x3/tracks/cosearch/seeds/t1.txt
let a = 4
let r = 30
# P4 (1,4): s1 at a, s6 at a+20; lifted P4 (1,3): s4 at a+10 (QC through (1,4), fires as P5 spits it)
open a-1 set 1 4 1 minecraft:redstone_block
open a+1 clear 1 4 1
open a+9 set 1 3 1 minecraft:redstone_block
open a+11 clear 1 3 1
open a+19 set 1 4 1 minecraft:redstone_block
open a+21 clear 1 4 1
close a-1 set 1 4 1 minecraft:redstone_block
close a+1 clear 1 4 1
close a+9 set 1 3 1 minecraft:redstone_block
close a+11 clear 1 3 1
close a+19 set 1 4 1 minecraft:redstone_block
close a+21 clear 1 4 1
# PT (3,3): s2 at a+4
open a+3 set 3 3 1 minecraft:redstone_block
open a+5 clear 3 3 1
close a+3 set 3 3 1 minecraft:redstone_block
close a+5 clear 3 3 1
# P5 (1,5): s3 at a+8, s5 at a+14 (exactly 6 gt apart: K1's watcher sees 3 raw pulses)
open a+7 set 1 5 1 minecraft:redstone_block
open a+9 clear 1 5 1
open a+13 set 1 5 1 minecraft:redstone_block
open a+15 clear 1 5 1
close a+7 set 1 5 1 minecraft:redstone_block
close a+9 clear 1 5 1
close a+13 set 1 5 1 minecraft:redstone_block
close a+15 clear 1 5 1
# PTR (4,2) + PMR (4,1) together (a real O(4,3) facing up: direct + QC): 3 pulses 6 gt apart
open r-1 set 4 2 1 minecraft:redstone_block
open r-1 set 4 1 1 minecraft:redstone_block
open r+1 clear 4 2 1
open r+1 clear 4 1 1
open r+5 set 4 2 1 minecraft:redstone_block
open r+5 set 4 1 1 minecraft:redstone_block
open r+7 clear 4 2 1
open r+7 clear 4 1 1
open r+11 set 4 2 1 minecraft:redstone_block
open r+11 set 4 1 1 minecraft:redstone_block
open r+13 clear 4 2 1
open r+13 clear 4 1 1
close r-1 set 4 2 1 minecraft:redstone_block
close r-1 set 4 1 1 minecraft:redstone_block
close r+1 clear 4 2 1
close r+1 clear 4 1 1
close r+5 set 4 2 1 minecraft:redstone_block
close r+5 set 4 1 1 minecraft:redstone_block
close r+7 clear 4 2 1
close r+7 clear 4 1 1
close r+11 set 4 2 1 minecraft:redstone_block
close r+11 set 4 1 1 minecraft:redstone_block
close r+13 clear 4 2 1
close r+13 clear 4 1 1
