# e88 t1: level-held T puller (real lever on its top), everything else ideal.
# A' pulses 1/2 only on open (a gate: BM parked at (0,-1) only while open).
design designs/piston-door-3x3/tracks/e88/wip/t1.txt
let a0 = 2
let pm = 6
let b = 12
let a1 = 14
let a2 = 22
let l = 14
let r = 30
open 0 use 1 5 0
open a0 set 0 -2 0 minecraft:redstone_block
open a0+2 clear 0 -2 0
open pm set -1 -1 1 minecraft:redstone_block
open pm+2 clear -1 -1 1
open b set 1 -3 1 minecraft:redstone_block
open b+8 clear 1 -3 1
open a1 set 1 -1 1 minecraft:redstone_block
open a1+2 clear 1 -1 1
open a2 set 1 -1 1 minecraft:redstone_block
open a2+2 clear 1 -1 1
open l set -2 0 1 minecraft:redstone_block
open l set -2 1 1 minecraft:redstone_block
open l set -2 2 1 minecraft:redstone_block
open l+2 clear -2 0 1
open l+2 clear -2 1 1
open l+2 clear -2 2 1
open r set 4 0 1 minecraft:redstone_block
open r set 4 1 1 minecraft:redstone_block
open r set 4 2 1 minecraft:redstone_block
open r+2 clear 4 0 1
open r+2 clear 4 1 1
open r+2 clear 4 2 1
close 0 use 1 5 0
close a0 set 0 -2 0 minecraft:redstone_block
close a0+2 clear 0 -2 0
close pm set -1 -1 1 minecraft:redstone_block
close pm+2 clear -1 -1 1
close b set 1 -3 1 minecraft:redstone_block
close b+8 clear 1 -3 1
close l set -2 0 1 minecraft:redstone_block
close l set -2 1 1 minecraft:redstone_block
close l set -2 2 1 minecraft:redstone_block
close l+2 clear -2 0 1
close l+2 clear -2 1 1
close l+2 clear -2 2 1
close r set 4 0 1 minecraft:redstone_block
close r set 4 1 1 minecraft:redstone_block
close r set 4 2 1 minecraft:redstone_block
close r+2 clear 4 0 1
close r+2 clear 4 1 1
close r+2 clear 4 2 1
