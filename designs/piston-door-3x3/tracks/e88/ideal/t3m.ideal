# t3p: lever (1,5) holds TL/T/TR; real gate observer (0,-2) + shuttle SP (-2,-3)/R (-1,-3);
# every other input ideal behind its piston (z+1): A' pulse 0, P_M, SP (s1 push, s2 pull),
# B' boost (B' must extend when R starts moving, so the gate's first pulse meets A' landing).
design designs/piston-door-3x3/tracks/e88/wip/t3m.txt
let a0 = 14
let pm = 20
let s1 = 26
let bb = 25
let s2 = 36
open 0 use 1 5 0
close 0 use 1 5 0
open pm set -1 -1 1 minecraft:redstone_block
open pm+2 clear -1 -1 1
close pm set -1 -1 1 minecraft:redstone_block
close pm+2 clear -1 -1 1
open s1 set -2 -3 1 minecraft:redstone_block
open s1+2 clear -2 -3 1
close s1 set -2 -3 1 minecraft:redstone_block
close s1+2 clear -2 -3 1
open s2 set -2 -3 1 minecraft:redstone_block
open s2+2 clear -2 -3 1
close s2 set -2 -3 1 minecraft:redstone_block
close s2+2 clear -2 -3 1
open bb set 1 -3 1 minecraft:redstone_block
open bb+2 clear 1 -3 1
