# t3p: lever (1,5) holds TL/T/TR; real gate observer (0,-2) + shuttle SP (-2,-3)/R (-1,-3);
# every other input ideal behind its piston (z+1): A' pulse 0, P_M, SP (s1 push, s2 pull),
# B' boost (B' must extend when R starts moving, so the gate's first pulse meets A' landing).
design designs/piston-door-3x3/tracks/e88/wip/t3p.txt
let a0 = 2
let pm = 6
let s1 = 12
let bb = 12
let s2 = 22
let l = 14
let r = 30
open 0 use 1 5 0
close 0 use 1 5 0
open a0 set 1 -2 1 minecraft:redstone_block
open a0+2 clear 1 -2 1
close a0 set 1 -2 1 minecraft:redstone_block
close a0+2 clear 1 -2 1
open pm set -1 -1 1 minecraft:redstone_block
open pm+2 clear -1 -1 1
close pm set -1 -1 1 minecraft:redstone_block
close pm+2 clear -1 -1 1
open s1 set -2 -3 1 minecraft:redstone_block
open s1+2 clear -2 -3 1
close s1 set -2 -3 1 minecraft:redstone_block
close s1+2 clear -2 -3 1
open s2 set -2 -3 1 minecraft:redstone_block
open s2+2 clear -2 -3 1
close s2 set -2 -3 1 minecraft:redstone_block
close s2+2 clear -2 -3 1
open bb set 1 -3 1 minecraft:redstone_block
open bb+2 clear 1 -3 1
close bb set 1 -3 1 minecraft:redstone_block
close bb+2 clear 1 -3 1
open l set -2 1 1 minecraft:redstone_block
open l set -2 0 1 minecraft:redstone_block
open l+2 clear -2 1 1
open l+2 clear -2 0 1
close l set -2 1 1 minecraft:redstone_block
close l set -2 0 1 minecraft:redstone_block
close l+2 clear -2 1 1
close l+2 clear -2 0 1
open r set 4 1 1 minecraft:redstone_block
open r set 4 0 1 minecraft:redstone_block
open r+2 clear 4 1 1
open r+2 clear 4 0 1
close r set 4 1 1 minecraft:redstone_block
close r set 4 0 1 minecraft:redstone_block
close r+2 clear 4 1 1
close r+2 clear 4 0 1
