# wire131: f131N with ideal inputs only for N's train (redstone block behind N), P3's pulse (behind P3), DE's window
# ((0,5), as in wire64's plans) and S_R's pulse (behind S_R).
design designs/piston-door-3x3/tracks/f131/f131N.txt
let on1 = 0
let on2 = 12
let on3 = 22
let cn1 = 0
let cn2 = 12
let cn3 = 22
let opx = 9
let cpx = 6
let oe1 = 13
let ce1 = 12
let or = 22
let cr = 22
let os = 30
let cs = 30
open on1 set -2 4 1 minecraft:redstone_block
open on2 clear -2 4 1
open on3 set -2 4 1 minecraft:redstone_block
close cn1 clear -2 4 1
close cn2 set -2 4 1 minecraft:redstone_block
close cn3 clear -2 4 1
open opx set -1 3 1 minecraft:redstone_block
open opx+2 clear -1 3 1
close cpx set -1 3 1 minecraft:redstone_block
close cpx+2 clear -1 3 1
open oe1 set 0 5 0 minecraft:redstone_block
open or clear 0 5 0
close ce1 set 0 5 0 minecraft:redstone_block
close cr clear 0 5 0
open os set 4 6 1 minecraft:redstone_block
open os+2 clear 4 6 1
close cs set 4 6 1 minecraft:redstone_block
close cs+2 clear 4 6 1
