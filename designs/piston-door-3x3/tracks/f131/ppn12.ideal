# pn10 with DE driven by TWO 2 gt pulses (e1 push + spit, e2 pull) behind it; PN still from the
# observer (0,5) watching DE (real).
design designs/piston-door-3x3/tracks/f131/pn10.txt
let oe1 = 12
let oe2 = 22
let ce1 = 12
let ce2 = 22
let op = 8
let cp = 8
let ol = 8
let cl = 8
let os = 24
let cs = 50
open 0 use -3 6 0
close 0 use -3 6 0
open oe1 set 1 5 1 minecraft:redstone_block
open oe1+2 clear 1 5 1
open oe2 set 1 5 1 minecraft:redstone_block
open oe2+2 clear 1 5 1
close ce1 set 1 5 1 minecraft:redstone_block
close ce1+2 clear 1 5 1
close ce2 set 1 5 1 minecraft:redstone_block
close ce2+2 clear 1 5 1
open op set -1 3 1 minecraft:redstone_block
open op+2 clear -1 3 1
close cp set -1 3 1 minecraft:redstone_block
close cp+2 clear -1 3 1
open ol set -2 2 1 minecraft:redstone_block
open ol+2 clear -2 2 1
close cl set -2 2 1 minecraft:redstone_block
close cl+2 clear -2 2 1
open os clear 4 6 1
close cs set 4 6 1 minecraft:redstone_block
