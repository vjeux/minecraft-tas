# pn18: pn17b + dust (1,6) on DE + dust (0,5) on (0,4) (step): O_D's two pulses reach DE AND PN
# (PN shots at e1 and e2); ideal: PN's late extra shot (od), P3, L1/L2, S_R+ (pull-type).
design designs/piston-door-3x3/tracks/f131/pn18.txt
let od = 25
let cd = 25
let op = 7
let cp = 7
let ol = 7
let cl = 7
let os = 30
let cs = 30
open 0 use -3 6 0
close 0 use -3 6 0
open od set -1 5 1 minecraft:redstone_block
