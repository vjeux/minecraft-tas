# pn21: pn20 without the P3/L observer chain: real DE pulses (O_D), S_R+ level chain (R1, bulb,
# comparator); ideal: PN window, P3, L1/L2.
design designs/piston-door-3x3/tracks/f131/pn23.txt
let pw = 11
let pl = 12
let cpw = 11
let cpl = 12
let op = 7
let cp = 7
let ol = 8
let cl = 8
open 0 use -3 6 0
close 0 use -3 6 0
open op set -1 3 1 minecraft:redstone_block
