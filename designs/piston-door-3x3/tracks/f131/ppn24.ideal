# pn13-like with the DE watcher (0,5) real: DE e1 = a pulse of l1 ticks at oe1, e2 = a pulse of l2 ticks
# at oe2 (behind DE); P3, L1/L2, S_R+ (pull-type) ideal.
design designs/piston-door-3x3/tracks/f131/pn13.txt
let oe1 = 11
let l1 = 1
let oe2 = 19
let l2 = 4
let ce1 = 11
let cl1 = 1
let ce2 = 19
let cl2 = 4
let op = 7
let cp = 7
let ol = 8
let cl = 8
let os = 34
let cs = 34
open 0 use -3 6 0
close 0 use -3 6 0
open oe1 set 1 5 1 minecraft:redstone_block
open oe1+l1 clear 1 5 1
open oe2 set 1 5 1 minecraft:redstone_block
open oe2+l2 clear 1 5 1
close ce1 set 1 5 1 minecraft:redstone_block
close ce1+cl1 clear 1 5 1
close ce2 set 1 5 1 minecraft:redstone_block
close ce2+cl2 clear 1 5 1
open op set -1 3 1 minecraft:redstone_block
open op+2 clear -1 3 1
close cp set -1 3 1 minecraft:redstone_block
close cp+2 clear -1 3 1
open ol set -2 2 1 minecraft:redstone_block
open ol+2 clear -2 2 1
close cl set -2 2 1 minecraft:redstone_block
close cl+2 clear -2 2 1
open os set 4 6 1 minecraft:redstone_block
open os+2 clear 4 6 1
close cs set 4 6 1 minecraft:redstone_block
close cs+2 clear 4 6 1
