# pn25: DE watcher (0,5) feeds PN (real); DE = O_D's first pulse (e1, real) + R1's merged window
# t20..30 through the note blocks (2,6) (quasi cell) and (2,5) (updates DE) (e2, real).
# S_R+ stays level-held at rest, ideal: a redstone block behind it, cleared at os / set back at cs.
design designs/piston-door-3x3/tracks/f131/pn25.txt
let op = 7
let cp = 7
let ol = 8
let cl = 8
let os = 30
let cs = 34
open 0 use -3 6 0
close 0 use -3 6 0
open op set -1 3 1 minecraft:redstone_block
open op+2 clear -1 3 1
close cp set -1 3 1 minecraft:redstone_block
close cp+2 clear -1 3 1
open ol set -2 2 1 minecraft:redstone_block
open ol+2 clear -2 2 1
close cl set -2 2 1 minecraft:redstone_block
close cl+2 clear -2 2 1
open os clear 4 6 1
close cs set 4 6 1 minecraft:redstone_block
