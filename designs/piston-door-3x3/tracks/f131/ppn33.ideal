# pn31 with P3 ideal on OPEN only (the lamp pulse t6..8 does close: push + spit)
# pn31 with P3 ideal on OPEN only (the lamp pulse t6..8 does close: push + spit)
design designs/piston-door-3x3/tracks/f131/pn31.txt
let op = 7
open 0 use -3 6 0
close 0 use -3 6 0
open op set -1 3 1 minecraft:redstone_block
open op+2 clear -1 3 1
