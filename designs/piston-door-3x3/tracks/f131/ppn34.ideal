# pn26b: L1/L2 as one hold [ls, ls+ll) (sensor shape), P3 ideal at 7
design designs/piston-door-3x3/tracks/f131/pn26b.txt
let op = 7
let cp = 7
let ls = 4
let ll = 10
let cls = 4
let cll = 10
open 0 use -3 6 0
close 0 use -3 6 0
open op set -1 3 1 minecraft:redstone_block
open op+2 clear -1 3 1
close cp set -1 3 1 minecraft:redstone_block
close cp+2 clear -1 3 1
open ls set -2 2 1 minecraft:redstone_block
open ls+ll clear -2 2 1
close cls set -2 2 1 minecraft:redstone_block
close cls+cll clear -2 2 1
