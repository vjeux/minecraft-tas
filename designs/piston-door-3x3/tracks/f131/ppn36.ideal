# pn26b: L1/L2 = two pulses (ol, ol2), P3 ideal
design designs/piston-door-3x3/tracks/f131/pn26b.txt
let op = 7
let cp = 7
let ol = 5
let ol2 = 11
let cl = 5
let cl2 = 11
open 0 use -3 6 0
close 0 use -3 6 0
open op set -1 3 1 minecraft:redstone_block
open op+2 clear -1 3 1
close cp set -1 3 1 minecraft:redstone_block
close cp+2 clear -1 3 1
open ol set -2 2 1 minecraft:redstone_block
open ol+2 clear -2 2 1
open ol2 set -2 2 1 minecraft:redstone_block
open ol2+2 clear -2 2 1
close cl set -2 2 1 minecraft:redstone_block
close cl+2 clear -2 2 1
close cl2 set -2 2 1 minecraft:redstone_block
close cl2+2 clear -2 2 1
