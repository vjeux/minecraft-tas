# pn4 with PN's shots b/c as two 2 gt pulses (ob, oc / cb, cc) instead of a window; DE window [oe, oee].
design designs/piston-door-3x3/tracks/f131/pn4.txt
let oa = 2
let ca = 2
let ob = 14
let oc = 22
let cb = 14
let cc = 22
let op = 8
let cp = 8
let ol = 2
let cl = 2
let oe = 14
let oee = 22
let ce = 14
let cee = 22
let os = 24
let cs = 24
open 0 use -3 6 0
close 0 use -3 6 0
