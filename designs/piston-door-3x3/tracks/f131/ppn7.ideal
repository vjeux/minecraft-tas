# pn4 with ONE shared window for PN and DE: [ow, ow+ol8) open, [cw, cw+cl8) close (one source powering
# both, e.g. a conductor at (0,5)), PN's first pulse oa/ca, P3, L1/L2, S_R+.
design designs/piston-door-3x3/tracks/f131/pn4.txt
let oa = 2
let ca = 2
let ow = 12
let cw = 12
let ol8 = 8
let cl8 = 8
let op = 8
let cp = 8
let ol = 2
let cl = 2
let os = 24
let cs = 24
open 0 use -3 6 0
close 0 use -3 6 0
open oa set -1 5 1 minecraft:redstone_block
open oa+2 clear -1 5 1
close ca set -1 5 1 minecraft:redstone_block
close ca+2 clear -1 5 1
open ow set 0 5 0 minecraft:redstone_block
open ow+ol8 set 0 5 0 minecraft:stone
close cw set 0 5 0 minecraft:redstone_block
close cw+cl8 set 0 5 0 minecraft:stone
open op set -1 3 1 minecraft:redstone_block
open op+2 clear -1 3 1
close cp set -1 3 1 minecraft:redstone_block
close cp+2 clear -1 3 1
open ol set -2 2 1 minecraft:redstone_block
open ol+2 clear -2 2 1
close cl set -2 2 1 minecraft:redstone_block
close cl+2 clear -2 2 1
open os clear 4 6 1
close cs set 4 6 1 minecraft:redstone_block
