# v0-left: real lever drives L stack, A (a1/a2/a3), B window; ideal P_T, R, M
design designs/piston-door-3x3/tracks/flat/v0-left.txt
let pt = 8
let m = 26
let r = 2
open 0 use -3 4 0
open pt set 3 4 0 minecraft:redstone_block
open pt+2 clear 3 4 0
open m set 1 -3 0 minecraft:redstone_block
open m+2 clear 1 -3 0
open r set 5 2 0 minecraft:redstone_block
open r set 5 1 0 minecraft:redstone_block
open r set 4 -1 0 minecraft:redstone_block
open r+2 clear 5 2 0
open r+2 clear 5 1 0
open r+2 clear 4 -1 0
close 0 use -3 4 0
close pt set 3 4 0 minecraft:redstone_block
close pt+2 clear 3 4 0
close m set 1 -3 0 minecraft:redstone_block
close m+2 clear 1 -3 0
close r set 5 2 0 minecraft:redstone_block
close r set 5 1 0 minecraft:redstone_block
close r set 4 -1 0 minecraft:redstone_block
close r+2 clear 5 2 0
close r+2 clear 5 1 0
close r+2 clear 4 -1 0
