# mp-mech with STEADY side pushers (H on/off at h, F on/off at s), pulses for A, P, U.
design designs/piston-door-3x3/tracks/fresh-b/mp-mech.txt
let h = 0
let a1 = 0
let s = 6
let t = 10
let tl = 4
let a2 = 16
let u = 20
let uu = 14
open h set 0 3 -1 minecraft:redstone_block
open a1 set 1 4 -1 minecraft:redstone_block
open a1+2 clear 1 4 -1
open s set 2 4 -1 minecraft:redstone_block
open t set 1 -2 -1 minecraft:redstone_block
open t+tl clear 1 -2 -1
open a2 set 1 4 -1 minecraft:redstone_block
open a2+2 clear 1 4 -1
open u set 0 -3 -1 minecraft:redstone_block
open u+2 clear 0 -3 -1
close h clear 0 3 -1
close a1 set 1 4 -1 minecraft:redstone_block
close a1+2 clear 1 4 -1
close s clear 2 4 -1
close t set 1 -2 -1 minecraft:redstone_block
close t+tl clear 1 -2 -1
close a2 set 1 4 -1 minecraft:redstone_block
close a2+2 clear 1 4 -1
close u set 0 -3 -1 minecraft:redstone_block
close u+2 clear 0 -3 -1
open uu set 0 -3 -1 minecraft:redstone_block
open uu+2 clear 0 -3 -1
close uu set 0 -3 -1 minecraft:redstone_block
close uu+2 clear 0 -3 -1
