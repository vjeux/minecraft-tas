# mp7 -> mp8: the bottom-left flag hangs under the left slime column at (-1,0,0); the observer
# (-2,-1,0) watches the cell it moves into, its output block (-2,-2,0) feeds R_P (-1,-2,0) whose
# output goes straight into the pump P (0,-2,0).
clear -1 1 -1
clear -2 0 -1
clear -2 -1 -1
clear -1 -1 -1
clear -1 -2 -1
clear 0 -1 -1
clear 0 -2 -1
set -1 0 0 minecraft:stone
set -2 -1 0 minecraft:observer[facing=up]
set -2 -2 0 minecraft:stone
set -1 -3 0 minecraft:smooth_stone
set -1 -2 0 minecraft:repeater[facing=west,delay=2]
