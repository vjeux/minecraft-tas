# fc1: rb6 mechanism, symmetric control: Q delayed by a repeater, A pulsed (p0) before Q,
# B blocked on close by the re-extended A. X moved to (0,4,0) west of A.
clear -1 6 -1
clear -1 5 -1
clear -2 6 -1
clear -3 6 -1
clear -3 5 -1
clear -2 5 -1
clear -2 4 -1
clear 0 6 -1
clear 0 5 -1
clear 0 6 0
clear 0 6 1
clear 0 6 2
clear 0 5 2
clear 1 6 2
clear 1 6 1
clear 1 5 1
clear 1 4 1
clear 1 3 1
clear 0 4 -1
clear 1 4 -1
clear 0 4 0
clear -1 3 0
clear -1 4 0
# left: backbone (-1,-1..2,0), P_L under the walkway
set -1 -1 0 minecraft:slime_block
set 0 -1 0 minecraft:sticky_piston[extended=false,facing=west]
# Q + RB on z=+1
set 0 4 1 minecraft:sticky_piston[extended=false,facing=east]
set 1 4 1 minecraft:redstone_block
# lever (-2,4,0) on (-2,4,1); R_q reads it, powers Q
set -2 4 1 minecraft:stone
set -2 4 0 minecraft:lever[face=wall,facing=north,powered=false]
port lever -2 4 0
set -1 3 1 minecraft:stone
set -1 4 1 minecraft:repeater[delay=2,facing=west,locked=false,powered=false]
# p0: O_a watches the lever, lights X (0,4,0) on (0,3,0)
set -1 4 0 minecraft:observer[facing=west,powered=false]
set 0 3 0 minecraft:stone
set 0 4 0 minecraft:redstone_wire[east=side,north=none,power=0,south=none,west=side]
# B window: O_b watches O_a, powers J -> R_B (0,6,0) -> B QC; O watches R_B -> X
set -1 5 0 minecraft:observer[facing=down,powered=false]
set -1 6 0 minecraft:stone
set 0 5 0 minecraft:observer[facing=up,powered=false]
set 0 6 0 minecraft:repeater[delay=4,facing=west,locked=false,powered=false]
