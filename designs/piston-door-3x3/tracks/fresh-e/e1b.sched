# e1: p0 A pulse, side pulses (P_R push-type at 2,-1,0; P_L pull-type at -3,1,0), P_M pulse, B window
design designs/piston-door-3x3/tracks/fresh-e/e1-mech.txt
let p = 2
let sr = 4
let sl = 4
let b = 14
let bw = 8
open p set 1 4 1 minecraft:redstone_block
open p+2 clear 1 4 1
open sr set 2 -2 0 minecraft:redstone_block
open sr+2 clear 2 -2 0
open sl set -4 1 0 minecraft:redstone_block
open sl+2 clear -4 1 0
open b set 1 6 0 minecraft:redstone_block
open b+bw clear 1 6 0
open b+2 set 1 3 1 minecraft:redstone_block
open b+4 clear 1 3 1
open b+bw+2 set 1 4 1 minecraft:redstone_block
open b+bw+4 clear 1 4 1
close p set 1 4 1 minecraft:redstone_block
close p+2 clear 1 4 1
close sr set 2 -2 0 minecraft:redstone_block
close sr+2 clear 2 -2 0
close sl set -4 1 0 minecraft:redstone_block
close sl+2 clear -4 1 0
close b set 1 6 0 minecraft:redstone_block
close b+bw clear 1 6 0
close b+2 set 1 3 1 minecraft:redstone_block
close b+4 clear 1 3 1
close b+bw+2 set 1 4 1 minecraft:redstone_block
close b+bw+4 clear 1 4 1
