# t2: 3-slime chain; open R3 (RB), S1 pull at s, S2 (lower only, input (0,-5,0)) pull at a2; close S2 push at a1, S1 push at s
design designs/piston-door-3x3/tracks/gravity-2/t2.txt
let s = 6
let a1 = 2
let a2 = 12
let w = 2
open 0 use 1 3 0
open a1 set 0 -5 0 minecraft:redstone_block
open a1+w clear 0 -5 0
open s set 0 -6 1 minecraft:redstone_block
open s+2 clear 0 -6 1
open a2 set 0 -5 0 minecraft:redstone_block
open a2+w clear 0 -5 0
close 0 use 1 3 0
close a1 set 0 -5 0 minecraft:redstone_block
close a1+w clear 0 -5 0
close s set 0 -6 1 minecraft:redstone_block
close s+2 clear 0 -6 1
close a2 set 0 -5 0 minecraft:redstone_block
close a2+w clear 0 -5 0
