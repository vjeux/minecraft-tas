# t5: S1 is the right column's rest support (2,-1,0) above an x=2 chain; ideal S1 pulse at so/sc (RB at (2,-1,1))
design designs/piston-door-3x3/tracks/gravity-2/t5.txt
let so = 3
let sc = 3
open 0 use 1 3 0
open so set 2 -1 1 minecraft:redstone_block
open so+2 clear 2 -1 1
close 0 use 1 3 0
close sc set 2 -1 1 minecraft:redstone_block
close sc+2 clear 2 -1 1
