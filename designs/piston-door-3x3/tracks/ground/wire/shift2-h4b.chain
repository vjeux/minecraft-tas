# obs-chain spec for shift2: rows 1-2 (left) at 0,2,5,7,9,12 + far puller 14; row 0 (right) at 0,2,5,8,11,14 + far puller 14 (2 gt units; parity of every observer cell = root parity + time)
schedule designs/piston-door-3x3/tracks/ground/ideal/shift2.ideal
lever 1 3 -1 minecraft:lever[face=wall,facing=north,powered=false]
support 1 3 0 minecraft:stone
root 1 3 -2 south
box -3 0 -2 5 3 2
# ---- left: rows 1-2 (P home/shifted, Q, Z at (-1,y,-1) facing south), row 0's far puller
group P1H 0
optb -2 3 1 south -2 3 0 minecraft:stone
optb -2 3 -1 north -2 3 0 minecraft:stone
opt -2 3 0 up
opt -2 2 1 south
opt -2 2 -1 north
group Z2 2
optb -2 3 -1 west -1 3 -1 minecraft:stone
opt -1 3 -1 up
opt -1 2 -2 north
opt -2 2 -1 west
group Q3 5
opt -3 3 0 up
opt -4 2 0 west
opt -3 2 1 south
opt -3 2 -1 north
group PS4 8
optb -2 3 0 west -1 3 0 minecraft:stone
optb -1 3 1 south -1 3 0 minecraft:stone
optb -1 3 -1 north -1 3 0 minecraft:stone
group Q5 11
opt -3 3 0 up
opt -4 2 0 west
opt -3 2 1 south
opt -3 2 -1 north
group P6H 14
optb -2 3 1 south -2 3 0 minecraft:stone
optb -2 3 -1 north -2 3 0 minecraft:stone
opt -2 3 0 up
opt -2 2 1 south
opt -2 2 -1 north
group LP0 14
opt -3 0 0 west
opt -2 0 1 south
opt -2 0 -1 north
# ---- right: row 0 (P0 home/shifted, Q0, Z0 at (3,0,1) facing north), rows 1-2's far pullers
group R1H 0
opt 4 0 -1 north
opt 4 0 1 south
group RZ2 2
opt 3 0 2 south
opt 3 1 1 up
opt 4 0 1 east
group RQ3 5
opt 6 0 0 east
opt 5 1 0 up
opt 5 0 -1 north
opt 5 0 1 south
group RPS4 8
opt 3 1 -1 north
opt 3 1 1 south
group RQ5 11
opt 6 0 0 east
opt 5 1 0 up
opt 5 0 -1 north
opt 5 0 1 south
group R6H 14
opt 4 0 -1 north
opt 4 0 1 south
group RP7 14
opt 4 3 0 up
opt 5 2 0 east
opt 4 2 -1 north
opt 4 2 1 south
