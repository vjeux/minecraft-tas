# from lm2-53: P_L moves to the top row (-3,2,0) and is fired by an observer chain watching
# P_T (one state change per lever edge): (0,3,2) -> (-1,3,2) -> (-2,3,2) -> (-3,3,2) -> (-3,3,1),
# whose back gives signal into (-3,3,0), P_L's quasi-connectivity cell.
clear 1 -1 1
clear 0 -1 1
clear -1 -1 1
clear -2 -1 1
clear -3 -1 1
clear -3 0 1
clear -3 0 0
set -3 2 0 minecraft:sticky_piston[facing=east,extended=false]
set 0 3 2 minecraft:observer[facing=east]
set -1 3 2 minecraft:observer[facing=east]
set -2 3 2 minecraft:observer[facing=east]
set -3 3 2 minecraft:observer[facing=east]
set -3 3 1 minecraft:observer[facing=south]
