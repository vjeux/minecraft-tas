# from lm6-49: P_L back on the bottom chain (watches the bottom-middle cell, never flaps), so
# the door itself does not move again while closing (only P_T's head re-cycles behind the wall).
clear 0 3 2
clear -1 3 2
clear -2 3 2
clear -3 3 2
clear -3 3 1
clear -3 2 0
set -3 0 0 minecraft:sticky_piston[facing=east,extended=false]
set 1 -1 1 minecraft:observer[facing=north]
set 0 -1 1 minecraft:observer[facing=east]
set -1 -1 1 minecraft:observer[facing=east]
set -2 -1 1 minecraft:observer[facing=east]
set -3 -1 1 minecraft:stone
set -3 0 1 minecraft:redstone_wire[north=side,east=side,south=side,west=side]
