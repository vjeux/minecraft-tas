# mm10a: mirrored u7-m10 with the TOP real: lever on the front face of (4,3) holds R0' (direct) + R1' (QC);
# observer (3,3) facing down on R0''s head cell -> lamp (3,4) -> observer (2,4) -> U' (1,4) at t5 and t11;
# U' watcher (0,4) -> observer (-1,4) -> stone (-2,4) -> dust (-2,3) under it, on L0': K' + L0' (TL) + L1' (ML, QC).
# Bottom ideal: A' hold, BRp + B' levels, A''s last pull, L2' (BL).
design designs/piston-door-3x3/tracks/m56/mm10a.txt
let ah0 = 8
let ah = 4
