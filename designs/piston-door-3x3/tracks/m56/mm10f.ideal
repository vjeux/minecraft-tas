# mm10c: mirrored u7-m10 with U' (1,4) EXTENDED at rest (level, head on TM). Real: lever on the front face of the
# dropper (4,3) (R0' direct, R1' QC); top-left chain (0,4) obs on U' -> (-1,4) obs -> dust (-2,4) on stone (-2,3):
# K' (east) + L0' (TL, below) + L1' (ML, QC); K' also QC-fed by (0,4) through (-1,4).
# Ideal: U' level (1,4,-1) + one U' pulse per edge, A' hold, BRp + B' levels, A''s last pull, L2' (BL).
design designs/piston-door-3x3/tracks/m56/mm10f.txt
let ud = 2
let up = 10
let ah0 = 6
let ah = 4
let tr = 8
let b = 16
let af = 22
let l2 = 11
let cp = 3
let cu = 12
let ctr = 8
let cb = 16
let cl2 = 11
open 0 use 5 3 0
open ud clear 1 4 -1
open up set 1 4 -1 minecraft:redstone_block
open up+2 clear 1 4 -1
open ah0 set 1 -1 -1 minecraft:redstone_block
open ah0+ah clear 1 -1 -1
open tr clear 2 -2 1
open b clear 1 -3 1
open af set 1 -2 1 minecraft:redstone_block
open af+2 clear 1 -2 1
open l2 set -2 0 -1 minecraft:redstone_block
open l2+2 clear -2 0 -1
close 0 use 5 3 0
close cp set 1 4 -1 minecraft:redstone_block
close cp+2 clear 1 4 -1
close cu set 1 4 -1 minecraft:redstone_block
close ctr set 2 -2 1 minecraft:redstone_block
close cb set 1 -3 1 minecraft:redstone_block
close cl2 set -2 0 -1 minecraft:redstone_block
close cl2+2 clear -2 0 -1
