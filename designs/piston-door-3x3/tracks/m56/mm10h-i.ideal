# mm10h: mirrored u7-m10, U' (1,4) extended at rest (level + one pulse), BRp (2,-2) and B' (1,-3) PULL-TYPE
# (retracted at rest: one pulse per edge each). Real: lever (5,3) on the dropper (4,3) (R0' direct, R1' QC), top-left
# chain (K', TL, ML). Ideal: U', A' hold, BRp, B', A''s last pull (1,-2,1), L2' (BL).
design designs/piston-door-3x3/tracks/m56/mm10h-i.txt
let ud = 2
let up = 10
let ah0 = 6
let ah = 4
let br = 8
let b = 16
let af = 22
let l2 = 11
let cp = 3
let cu = 12
let cbr = 8
let cb = 16
let cl2 = 11
open 0 use 5 3 0
open ud clear 1 4 -1
open up set 1 4 -1 minecraft:redstone_block
open up+2 clear 1 4 -1
open ah0 set 1 -1 -1 minecraft:redstone_block
open ah0+ah clear 1 -1 -1
open br set 2 -2 1 minecraft:redstone_block
open br+2 clear 2 -2 1
open b set 1 -3 1 minecraft:redstone_block
open b+2 clear 1 -3 1
open af set 1 -2 1 minecraft:redstone_block
open af+2 clear 1 -2 1
open l2 set -2 0 -1 minecraft:redstone_block
open l2+2 clear -2 0 -1
close 0 use 5 3 0
close cp set 1 4 -1 minecraft:redstone_block
close cp+2 clear 1 4 -1
close cu set 1 4 -1 minecraft:redstone_block
close cbr set 2 -2 1 minecraft:redstone_block
close cbr+2 clear 2 -2 1
close cb set 1 -3 1 minecraft:redstone_block
close cb+2 clear 1 -3 1
close cl2 set -2 0 -1 minecraft:redstone_block
close cl2+2 clear -2 0 -1
