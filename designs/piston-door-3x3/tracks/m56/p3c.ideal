design designs/piston-door-3x3/tracks/m56/p3c.txt
# p3: m10f + bottom-left K at U+2 (note block (-1,-2) under K) and L0 from an observer (-2,-1) facing down on a
# note block (-2,-2) lit by (-1,-2): one L0 pulse per (0,-2) pulse. U ideal: FIRST pulse 1 gt (u1..u1+1), second 2 gt.
let ah0 = 8
let ah = 4
let u1 = 5
let w1 = 1
let u2 = 11
let cu1 = 5
let cu2 = 11
let cw1 = 1
open 0 use 4 5 0
open ah0 set 1 3 -1 minecraft:redstone_block
open ah0+ah clear 1 3 -1
open u1 set 1 -2 -1 minecraft:redstone_block
open u1+w1 clear 1 -2 -1
open u2 set 1 -2 -1 minecraft:redstone_block
open u2+2 clear 1 -2 -1
close 0 use 4 5 0
close cu1 set 1 -2 -1 minecraft:redstone_block
close cu1+cw1 clear 1 -2 -1
close cu2 set 1 -2 -1 minecraft:redstone_block
close cu2+2 clear 1 -2 -1
