# m10e = c2e's m10b-uk bottom (U twice + K real) + m10top's top: B watcher (0,5) -> dust (-1,5) on an
# observer (-1,4) facing west -> dust (-2,4) on (-2,3) (L2 + L1 by QC: one pulse per edge); the observer
# (-1,4) watching that dust powers the STONE (0,4) 2 gt later: A at (1,4) (open) is updated and pulls TM
# up; A at (1,3) (close: it landed 2 gt earlier) is only QC-armed, never updated: no close shot.
# Ideal: A's hold and L0 only.
design designs/piston-door-3x3/tracks/m56/src/m10e.txt
let ah0 = 8
let ah = 4
let l0 = 11
open 0 use 4 5 0
open ah0 set 1 3 -1 minecraft:redstone_block
open ah0+ah clear 1 3 -1
open l0 set -2 0 -1 minecraft:redstone_block
open l0+2 clear -2 0 -1
close 0 use 4 5 0
close l0 set -2 0 -1 minecraft:redstone_block
close l0+2 clear -2 0 -1
