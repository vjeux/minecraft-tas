# m79a with B PULL-TYPE (retracted at rest, (1,4) empty) and the right-side HOLD family (c2e pockets):
# dust (3,5) on (3,4) drops TRp at t1 (TR lands in (2,3) at t3), repeater (3,3) d4 on the lever dust
# (4,3) keeps TR powered until t8: A holds t4..t8. B's pulse, A's last pull and L1/L2 ideal.
design designs/piston-door-3x3/tracks/m56/src/m79p.txt
let b = 10
let af = 14
let l12 = 14
let cb = 2
let cl = 0
open 0 use 4 5 0
open b set 1 5 -1 minecraft:redstone_block
open b+2 clear 1 5 -1
open af set 1 4 -1 minecraft:redstone_block
open af+2 clear 1 4 -1
open l12 set -2 2 -1 minecraft:redstone_block
open l12+2 clear -2 2 -1
close 0 use 4 5 0
close cb set 1 5 -1 minecraft:redstone_block
close cb+2 clear 1 5 -1
close cl set -2 2 -1 minecraft:redstone_block
close cl+2 clear -2 2 -1
