# m79s top (sculk, B pull-type, hold t4..t8) on c2e's 7x8 bottom (U from R0's watcher + lamp: U at 5 and 11);
# K (-1,-1) and L0 (-2,0) ideal.
design designs/piston-door-3x3/tracks/m79s/s78/s78a.txt
let k = 8
let l0 = 11
let ck = 8
let cl0 = 11
open 0 use 4 5 0
open k set -1 -1 -1 minecraft:redstone_block
open k+2 clear -1 -1 -1
open l0 set -2 0 -1 minecraft:redstone_block
open l0+2 clear -2 0 -1
close 0 use 4 5 0
close ck set -1 -1 -1 minecraft:redstone_block
close ck+2 clear -1 -1 -1
close cl0 set -2 0 -1 minecraft:redstone_block
close cl0+2 clear -2 0 -1
