# abpt21r driven like a wired door would be: the SAME times on both lever edges (symmetric),
# 2gt pulses for A (3x), P_T, M, P_L, P_R and an 8..12gt window for B (level on/off).
design designs/piston-door-3x3/tracks/mech-synth/wire/abpt21r-mech.txt
let pl = 0      # P_L pulse (left column), any time
let a0 = 0      # A pulse 1: open lifts T, close spits C down
let pt = 6      # P_T pulse: open pushes T to (2,3), close pulls it back
let bon = 12    # B on (window): open pushes A down, close pushes A,T,C down
let a3 = 18     # A pulse 2 (A down): open pulls C to (1,2), close spits T,C down
let boff = 24   # B off: B pulls A back up
let a5 = 30     # A pulse 3: open pulls C to (1,3), close no-op
let g = 36      # M pulse: open pulls M down, close pushes M,C,T back up
let pr = 36     # P_R pulse (right column), any time
open pl set -4 1 0 minecraft:redstone_block
open pl+2 clear -4 1 0
close pl set -4 1 0 minecraft:redstone_block
close pl+2 clear -4 1 0
open a0 set 2 4 0 minecraft:redstone_block
open a0+2 clear 2 4 0
close a0 set 2 4 0 minecraft:redstone_block
close a0+2 clear 2 4 0
open pt set 0 3 1 minecraft:redstone_block
open pt+2 clear 0 3 1
close pt set 0 3 1 minecraft:redstone_block
close pt+2 clear 0 3 1
open bon set 2 5 0 minecraft:redstone_block
open boff clear 2 5 0
close bon set 2 5 0 minecraft:redstone_block
close boff clear 2 5 0
open a3 set 1 3 1 minecraft:redstone_block
open a3+2 clear 1 3 1
close a3 set 1 3 1 minecraft:redstone_block
close a3+2 clear 1 3 1
open a5 set 2 4 0 minecraft:redstone_block
open a5+2 clear 2 4 0
close a5 set 2 4 0 minecraft:redstone_block
close a5+2 clear 2 4 0
open g set 1 -3 0 minecraft:redstone_block
open g+2 clear 1 -3 0
close g set 1 -3 0 minecraft:redstone_block
close g+2 clear 1 -3 0
open pr set 6 1 0 minecraft:redstone_block
open pr+2 clear 6 1 0
close pr set 6 1 0 minecraft:redstone_block
close pr+2 clear 6 1 0
