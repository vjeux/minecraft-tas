# T_A: the A torch moves next to the observer column and feeds A through the X dust; its
# attachment K=(4,5,0) carries the lever (A early for free) and a repeater from the P_T net
# (A late, +4gt), and no dust touches K (no backfeed). The lever net is fed by a repeater
# reading the lever (one-way).
# old lever / W / A torch / A early / A late out
clear 5 6 0
clear 4 6 0
clear 0 4 0
clear -1 4 0
clear -1 4 -1
clear -1 3 -1
clear -1 4 -2
clear -1 3 -2
clear -1 3 -3
clear -1 2 -3
clear -2 2 -3
clear -2 1 -3
clear -2 1 -2
clear -2 0 -2
clear -1 0 -2
clear -1 -1 -2
clear -1 -1 -1
clear -1 -2 -1
clear -1 -2 0
clear -1 -3 0
clear 2 4 3
clear 2 3 3
clear 1 4 3
clear 1 3 3
clear 0 4 3
clear 0 3 3
clear -1 3 3
clear -1 2 3
clear -1 4 2
clear -1 3 2
clear -1 4 1
clear -1 3 1
# old lever net start (lever block -> (5,4,0) -> (6,4,0) -> (6,4,1) -> (6,4,2))
clear 5 4 0
clear 5 3 0
clear 6 4 0
clear 6 3 0
clear 6 4 1
clear 6 3 1
# new lever on K, O2 watches it directly
set 4 6 0 minecraft:lever[face=floor,facing=west,powered=false]
port lever 4 6 0
# T_A under O2, powering the X2 dust that joins X
set 3 5 0 minecraft:redstone_wall_torch[facing=west,lit=true]
set 3 4 0 minecraft:redstone_wire
set 3 3 0 minecraft:white_glazed_terracotta[facing=north]
# lever net: repeater reading the lever, then down to (7,4,2)
set 5 6 0 minecraft:repeater[facing=west,delay=1]
set 6 6 0 minecraft:redstone_wire
set 6 5 0 minecraft:smooth_stone
set 7 5 0 minecraft:redstone_wire
set 7 4 0 minecraft:smooth_stone
set 7 4 1 minecraft:redstone_wire
set 7 3 1 minecraft:smooth_stone
# P_T L_8 feed moves to (5,4,2) into the block (4,4,2); dust (4,5,2) on it joins the P_T net
set 5 4 2 minecraft:repeater[facing=east,delay=2]
set 4 4 2 minecraft:smooth_stone
set 4 5 2 minecraft:redstone_wire
# A late: repeater from the P_T net into K
set 4 5 1 minecraft:repeater[facing=south,delay=2]
set 4 4 1 minecraft:smooth_stone
