# s27-bl52 with the top-right observers/dust erased; its pulses as plan inputs
design designs/piston-door-3x3/tracks/pockets/s26/b52-noTR.txt
let a = 22
let r = 20
let ca = 22
let cr = 20
open 0 use -4 1 0
close 0 use -4 1 0
close ca set 1 3 1 minecraft:redstone_block
