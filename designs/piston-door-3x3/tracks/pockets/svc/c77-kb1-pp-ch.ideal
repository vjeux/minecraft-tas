# pockets3: B' open = pulses at p1 (w1 gt) and p2 (w2 gt; p2 = 99: none), close = ONE hold [c, c+lc)
phase tile
let p1 = 18
let w1 = 2
let p2 = 99
let w2 = 2
let c = 30
let lc = 10
open 0 use 1 5 0
close 0 use 1 5 0
open p1 set 1 -3 1 minecraft:redstone_block
open p1+w1 clear 1 -3 1
open p2 set 1 -3 1 minecraft:redstone_block
open p2+w2 clear 1 -3 1
close c set 1 -3 1 minecraft:redstone_block
close c+lc clear 1 -3 1
