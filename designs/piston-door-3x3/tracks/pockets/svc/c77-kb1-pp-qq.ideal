# pockets3: B' open = 2-gt pulses at p1, p2; close = 2-gt pulses at q1, q2 (99 = none)
phase tile
let p1 = 18
let p2 = 30
let q1 = 30
let q2 = 99
let wq = 2
open 0 use 1 5 0
close 0 use 1 5 0
open p1 set 1 -3 1 minecraft:redstone_block
open p1+2 clear 1 -3 1
open p2 set 1 -3 1 minecraft:redstone_block
open p2+2 clear 1 -3 1
close q1 set 1 -3 1 minecraft:redstone_block
close q1+wq clear 1 -3 1
close q2 set 1 -3 1 minecraft:redstone_block
close q2+2 clear 1 -3 1
