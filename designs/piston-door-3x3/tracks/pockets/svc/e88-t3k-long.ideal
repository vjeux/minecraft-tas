# e88 t3k with the left shuttle's sticky piston (-2,-3) driven by ONE long pulse per edge
# (a plain sculk sensor's 30 gt output): extend at s1 (the redstone block pushed into (0,-3)),
# retract at s1+w (pulled back): does a single long pulse replace the push / pull pair?
design designs/piston-door-3x3/tracks/pockets/svc/e88-t3k.txt
let s1 = 26
let w = 10
open 0 use 1 5 0
close 0 use 1 5 0
open s1 set -2 -3 1 minecraft:redstone_block
open s1+w clear -2 -3 1
close s1 set -2 -3 1 minecraft:redstone_block
close s1+w clear -2 -3 1
