# free-Q ideal test: lever QC-powers Q silently; wake = redstone block under Q at d..d+2
design designs/piston-door-3x3/tracks/q-free/l1-mech.txt
let d = 4
let b = 12
let pl = 4
open 0 use -1 5 1
open d set 0 3 1 minecraft:redstone_block
open d+2 clear 0 3 1
open pl set -4 2 0 minecraft:redstone_block
open pl+2 clear -4 2 0
open b set 1 6 0 minecraft:redstone_block
open b+8 clear 1 6 0
open b+2 set 1 3 -1 minecraft:redstone_block
open b+4 clear 1 3 -1
open b+10 set 1 4 -1 minecraft:redstone_block
open b+12 clear 1 4 -1
close 0 use -1 5 1
close d set 0 3 1 minecraft:redstone_block
close d+2 clear 0 3 1
close pl set -4 2 0 minecraft:redstone_block
close pl+2 clear -4 2 0
close b set 1 6 0 minecraft:redstone_block
close b+8 clear 1 6 0
close b+2 set 1 3 -1 minecraft:redstone_block
close b+4 clear 1 3 -1
close b+10 set 1 4 -1 minecraft:redstone_block
close b+12 clear 1 4 -1
