# e78s: B' as ONE hold [b, b+bl] (a calibrated sensor window) on both edges; A1, K, A2, A3 pulses
let a1 = 8
let k = 14
let b = 20
let bl = 10
let a2 = 24
let a3 = 36
let ck = 14
open 0 use 1 5 0
close 0 use 1 5 0
open a1 set 1 -2 1 minecraft:redstone_block
open a1+2 clear 1 -2 1
open k set 3 -1 1 minecraft:redstone_block
open k+2 clear 3 -1 1
open b set 1 -3 1 minecraft:redstone_block
open b+bl clear 1 -3 1
open a2 set 1 -1 1 minecraft:redstone_block
open a2+2 clear 1 -1 1
open a3 set 1 -2 1 minecraft:redstone_block
open a3+2 clear 1 -2 1
close a1 set 1 -2 1 minecraft:redstone_block
close a1+2 clear 1 -2 1
close ck set 3 -1 1 minecraft:redstone_block
close ck+2 clear 3 -1 1
close b set 1 -3 1 minecraft:redstone_block
close b+bl clear 1 -3 1
