open d+b1+2 clear 1 -3 1
open d+a2 set 1 -1 1 minecraft:redstone_block
open d+a2+2 clear 1 -1 1
open d+b2 set 1 -3 1 minecraft:redstone_block
open d+b2+2 clear 1 -3 1
open d+a3 set 1 -2 1 minecraft:redstone_block
open d+a3+2 clear 1 -2 1
close s set -2 1 1 minecraft:redstone_block
close s+2 clear -2 1 1
close s set 4 1 1 minecraft:redstone_block
close s+2 clear 4 1 1
close d+ca1 set 1 -2 1 minecraft:redstone_block
close d+ca1+2 clear 1 -2 1
close d+ck set 3 -1 1 minecraft:redstone_block
close d+ck+2 clear 3 -1 1
close d+cb1 set 1 -3 1 minecraft:redstone_block
