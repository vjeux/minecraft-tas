# asymmetric: open A K B A B A, close A K B B (B' lift pushes A'+BM+C home, then lowers A'); every input off-plane.
let s = 2
open 0 use 1 5 0
close 0 use 1 5 0
let d = 0
let a1 = 0
let k = 6
let b1 = 12
let a2 = 16
let b2 = 22
let a3 = 28
let ca1 = 0
let ck = 6
let cb1 = 12
let cb2 = 18
open s set -2 1 1 minecraft:redstone_block
open s+2 clear -2 1 1
open s set 4 1 1 minecraft:redstone_block
open s+2 clear 4 1 1
open d+a1 set 1 -2 1 minecraft:redstone_block
open d+a1+2 clear 1 -2 1
open d+k set 3 -1 1 minecraft:redstone_block
open d+k+2 clear 3 -1 1
