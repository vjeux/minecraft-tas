# e78s bottom pattern test: K = one hold [k, k+kl] on both edges; B' taps at b, b+db, b+2db (3rd optional via b3on)
# from one sensor's observer; gate (A2/A3 via (1,-1)) = each B tap + dg on OPEN only (BM parked in F2)
let a1 = 8
let k = 8
let kl = 10
let b = 18
let db = 10
let dg = 2
let b3 = 300
open 0 use 1 5 0
close 0 use 1 5 0
open a1 set 1 -2 1 minecraft:redstone_block
open a1+2 clear 1 -2 1
open k set 3 -1 1 minecraft:redstone_block
open k+kl clear 3 -1 1
open b set 1 -3 1 minecraft:redstone_block
open b+2 clear 1 -3 1
open b+dg set 1 -1 1 minecraft:redstone_block
open b+dg+2 clear 1 -1 1
open b+db set 1 -3 1 minecraft:redstone_block
open b+db+2 clear 1 -3 1
open b+db+dg set 1 -1 1 minecraft:redstone_block
open b+db+dg+2 clear 1 -1 1
open b3 set 1 -3 1 minecraft:redstone_block
open b3+2 clear 1 -3 1
close a1 set 1 -2 1 minecraft:redstone_block
close a1+2 clear 1 -2 1
close k set 3 -1 1 minecraft:redstone_block
close k+kl clear 3 -1 1
close b set 1 -3 1 minecraft:redstone_block
close b+2 clear 1 -3 1
close b+db set 1 -3 1 minecraft:redstone_block
close b+db+2 clear 1 -3 1
close b3 set 1 -3 1 minecraft:redstone_block
close b3+2 clear 1 -3 1
