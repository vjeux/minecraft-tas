# e78s windows: every bottom event its own variable (open A1 K B1 A2 B2 A3, close A1 K B1 B2), 2 gt pulses
let a1 = 8
let k = 14
let b1 = 20
let a2 = 24
let b2 = 30
let a3 = 36
let ca1 = 8
let ck = 14
let cb1 = 20
let cb2 = 26
let kl = 2
let ckl = 2
open 0 use 1 5 0
open a1 set 1 -2 1 minecraft:redstone_block
open a1+2 clear 1 -2 1
open k set 3 -1 1 minecraft:redstone_block
open k+kl clear 3 -1 1
open b1 set 1 -3 1 minecraft:redstone_block
open b1+2 clear 1 -3 1
open a2 set 1 -1 1 minecraft:redstone_block
open a2+2 clear 1 -1 1
open b2 set 1 -3 1 minecraft:redstone_block
open b2+2 clear 1 -3 1
open a3 set 1 -2 1 minecraft:redstone_block
open a3+2 clear 1 -2 1
close 0 use 1 5 0
close a1 set 1 -2 1 minecraft:redstone_block
close a1+2 clear 1 -2 1
close k set 3 -1 1 minecraft:redstone_block
close k+kl clear 3 -1 1
close b1 set 1 -3 1 minecraft:redstone_block
close b1+2 clear 1 -3 1
close a2 set 1 -1 1 minecraft:redstone_block
close a2+2 clear 1 -1 1
close b2 set 1 -3 1 minecraft:redstone_block
close b2+2 clear 1 -3 1
close a3 set 1 -2 1 minecraft:redstone_block
close a3+2 clear 1 -2 1
