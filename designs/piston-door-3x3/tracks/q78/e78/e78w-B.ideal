# e78w with the B' sensor (0,-3) replaced by ideal holds on B' (via (0,-3,1)... no: a redstone block AT (0,-3)); MR+BR ideal at r
let r = 18
let bs = 10
let bl = 10
let bs2 = 34
let bl2 = 10
open 0 use 1 5 0
close 0 use 1 5 0
open r set 4 1 1 minecraft:redstone_block
open r+2 clear 4 1 1
open bs set 0 -3 0 minecraft:redstone_block
open bs+bl set 0 -3 0 minecraft:air
open bs2 set 0 -3 0 minecraft:redstone_block
open bs2+bl2 set 0 -3 0 minecraft:air
close r set 4 1 1 minecraft:redstone_block
close r+2 clear 4 1 1
close bs set 0 -3 0 minecraft:redstone_block
close bs+bl set 0 -3 0 minecraft:air
close bs2 set 0 -3 0 minecraft:redstone_block
close bs2+bl2 set 0 -3 0 minecraft:air
