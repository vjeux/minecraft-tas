# q8LL: A real (top-left screen); W, B (two 2 gt pulses), TR+MR, BR, BL, U ideal
let w = 11
let b1 = 14
let b2 = 40
let tr = 30
let bl0 = 30
let br = 30
let bm = 70
open 0 use -3 2 0
close 0 use -3 2 0
open w set 3 3 1 minecraft:redstone_block
open w+2 clear 3 3 1
open b1 set 1 5 1 minecraft:redstone_block
open b1+2 clear 1 5 1
open b2 set 1 5 1 minecraft:redstone_block
open b2+2 clear 1 5 1
