open br+2 clear 4 0 1
open bm set 1 -2 1 minecraft:redstone_block
open bm+2 clear 1 -2 1
close w set 3 3 1 minecraft:redstone_block
close w+2 clear 3 3 1
close b1 set 1 5 1 minecraft:redstone_block
close b1+2 clear 1 5 1
close b2 set 1 5 1 minecraft:redstone_block
close b2+2 clear 1 5 1
close tr set 4 2 1 minecraft:redstone_block
close tr+2 clear 4 2 1
close bl0 set -2 0 1 minecraft:redstone_block
close bl0+2 clear -2 0 1
