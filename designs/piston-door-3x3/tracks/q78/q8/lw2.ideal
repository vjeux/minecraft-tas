# q8L: W real (screened in the top-right); A at a, a+10, a+20 and B hold [a+db, a+db+bl] ideal; TL, BL, BR, U ideal
let a = 6
let db = 8
let bl = 10
let da3 = 20
let tl = 42
let bl0 = 42
let br = 42
let bm = 50
open 0 use 5 2 0
close 0 use 5 2 0
open a set 1 4 1 minecraft:redstone_block
open a+2 clear 1 4 1
open a+db set 1 5 1 minecraft:redstone_block
open a+db+bl clear 1 5 1
open a+10 set 1 3 1 minecraft:redstone_block
open a+12 clear 1 3 1
open a+da3 set 1 4 1 minecraft:redstone_block
