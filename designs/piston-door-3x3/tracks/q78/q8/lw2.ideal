open bl0 set -2 0 1 minecraft:redstone_block
open bl0+2 clear -2 0 1
open br set 4 0 1 minecraft:redstone_block
open br+2 clear 4 0 1
open bm set 1 -2 1 minecraft:redstone_block
open bm+2 clear 1 -2 1
close a set 1 4 1 minecraft:redstone_block
close a+2 clear 1 4 1
close a+db set 1 5 1 minecraft:redstone_block
close a+db+bl clear 1 5 1
close a+10 set 1 3 1 minecraft:redstone_block
close a+12 clear 1 3 1
close a+da3 set 1 4 1 minecraft:redstone_block
close a+da3+2 clear 1 4 1
close tl set -2 2 1 minecraft:redstone_block
close tl+2 clear -2 2 1
close bl0 set -2 0 1 minecraft:redstone_block
close bl0+2 clear -2 0 1
close br set 4 0 1 minecraft:redstone_block
close br+2 clear 4 0 1
close bm set 1 -2 1 minecraft:redstone_block
close bm+2 clear 1 -2 1
