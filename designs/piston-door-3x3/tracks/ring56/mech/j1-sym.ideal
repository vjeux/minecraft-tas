design designs/piston-door-3x3/tracks/ring56/mech/j1.txt
# SAME schedule on both edges: A' pulses at a1,a2,a3 (A' fed via F0 + update at (0,-2)), B' 2 gt pulses at b1,b2
# (pulse B' = lift+spit, second pulse = lower), K pulse at k. Top + sides at t.
let t = 32
let a1 = 0
let k = 6
let b1 = 12
let a2 = 16
let b2 = 22
let a3 = 28
open t set 0 4 1 minecraft:redstone_block
open t set 1 4 1 minecraft:redstone_block
open t set 2 4 1 minecraft:redstone_block
open t+2 clear 0 4 1
open t+2 clear 1 4 1
open t+2 clear 2 4 1
open t set -2 1 1 minecraft:redstone_block
open t set 4 1 1 minecraft:redstone_block
open t+2 clear -2 1 1
open t+2 clear 4 1 1
open a1 set 0 -1 0 minecraft:redstone_block
open a1 set 0 -2 0 minecraft:stone
open a1+2 clear 0 -1 0
open a1+2 clear 0 -2 0
open k set 3 -1 1 minecraft:redstone_block
open k+2 clear 3 -1 1
open b1 set 1 -3 1 minecraft:redstone_block
open b1+2 clear 1 -3 1
open a2 set 0 -1 0 minecraft:redstone_block
open a2 set 0 -2 0 minecraft:stone
open a2+2 clear 0 -1 0
open a2+2 clear 0 -2 0
open b2 set 1 -3 1 minecraft:redstone_block
open b2+2 clear 1 -3 1
open a3 set 0 -1 0 minecraft:redstone_block
open a3 set 0 -2 0 minecraft:stone
open a3+2 clear 0 -1 0
open a3+2 clear 0 -2 0
close t set 0 4 1 minecraft:redstone_block
close t set 1 4 1 minecraft:redstone_block
close t set 2 4 1 minecraft:redstone_block
close t+2 clear 0 4 1
close t+2 clear 1 4 1
close t+2 clear 2 4 1
close t set -2 1 1 minecraft:redstone_block
close t set 4 1 1 minecraft:redstone_block
close t+2 clear -2 1 1
close t+2 clear 4 1 1
close a1 set 0 -1 0 minecraft:redstone_block
close a1 set 0 -2 0 minecraft:stone
close a1+2 clear 0 -1 0
close a1+2 clear 0 -2 0
close k set 3 -1 1 minecraft:redstone_block
close k+2 clear 3 -1 1
close b1 set 1 -3 1 minecraft:redstone_block
close b1+2 clear 1 -3 1
close a2 set 0 -1 0 minecraft:redstone_block
close a2 set 0 -2 0 minecraft:stone
close a2+2 clear 0 -1 0
close a2+2 clear 0 -2 0
close b2 set 1 -3 1 minecraft:redstone_block
close b2+2 clear 1 -3 1
close a3 set 0 -1 0 minecraft:redstone_block
close a3 set 0 -2 0 minecraft:stone
close a3+2 clear 0 -1 0
close a3+2 clear 0 -2 0
