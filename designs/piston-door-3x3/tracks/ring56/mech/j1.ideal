design designs/piston-door-3x3/tracks/ring56/mech/j1.txt
let top = 2
let side = 2
let a1 = 0
let cr = 6
let b1 = 12
let a2 = 16
let b2 = 22
let a3 = 28
# open: top row up, sides out (pulses)
open top set 0 4 1 minecraft:redstone_block
open top set 1 4 1 minecraft:redstone_block
open top set 2 4 1 minecraft:redstone_block
open top+2 clear 0 4 1
open top+2 clear 1 4 1
open top+2 clear 2 4 1
open side set -2 1 1 minecraft:redstone_block
open side set 4 1 1 minecraft:redstone_block
open side+2 clear -2 1 1
open side+2 clear 4 1 1
# bottom: A' pulse (QC via F0 + update at (0,-2)), corner puller, B' lift, A' pulse (high), B' drop, A' pulse
open a1 set 0 -1 0 minecraft:redstone_block
open a1 set 0 -2 0 minecraft:stone
open a1+2 clear 0 -1 0
open a1+2 clear 0 -2 0
open cr set 3 -1 1 minecraft:redstone_block
open cr+2 clear 3 -1 1
open b1 set 1 -3 1 minecraft:redstone_block
open a2 set 0 -1 0 minecraft:redstone_block
open a2+2 clear 0 -1 0
open b2 clear 1 -3 1
open a3 set 0 -1 0 minecraft:redstone_block
open a3 set 0 -2 0 minecraft:stone
open a3+2 clear 0 -1 0
open a3+2 clear 0 -2 0
# close
close top set 0 4 1 minecraft:redstone_block
close top set 1 4 1 minecraft:redstone_block
close top set 2 4 1 minecraft:redstone_block
close top+2 clear 0 4 1
close top+2 clear 1 4 1
close top+2 clear 2 4 1
close side set -2 1 1 minecraft:redstone_block
close side set 4 1 1 minecraft:redstone_block
close side+2 clear -2 1 1
close side+2 clear 4 1 1
close 0 set 0 -1 0 minecraft:redstone_block
close 0 set 0 -2 0 minecraft:stone
close 2 clear 0 -1 0
close 2 clear 0 -2 0
close 6 set 1 -3 1 minecraft:redstone_block
close 10 set 0 -1 0 minecraft:redstone_block
close 12 clear 0 -1 0
close 16 clear 1 -3 1
close 22 set 3 -1 1 minecraft:redstone_block
close 24 clear 3 -1 1
close 28 set 0 -1 0 minecraft:redstone_block
close 28 set 0 -2 0 minecraft:stone
close 30 clear 0 -1 0
close 30 clear 0 -2 0
