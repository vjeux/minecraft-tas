# SAME train both edges: A1 (1,-2,1); K double (y, y+4); F0 as redstone block around y+2 (close: A' pushes BM+C home when K spits BM into F1); B' b1,b2; gate pulses g1,g2 (note block (2,-3) via (2,-3,1)).
let a = 12
let y = 18
let f = 19
let b1 = 28
let g1 = 30
let b2 = 38
let g2 = 41
open 0 use -2 6 0
close 0 use -2 6 0
open a set 1 -2 1 minecraft:redstone_block
open a+2 clear 1 -2 1
open y set 3 -1 1 minecraft:redstone_block
open y+2 clear 3 -1 1
open y+4 set 3 -1 1 minecraft:redstone_block
open y+6 clear 3 -1 1
