open b2 set 1 -3 1 minecraft:redstone_block
open b2+2 clear 1 -3 1
open g1 set 2 -3 1 minecraft:redstone_block
open g1+2 clear 2 -3 1
open g2 set 2 -3 1 minecraft:redstone_block
open g2+2 clear 2 -3 1
close a set 1 -2 1 minecraft:redstone_block
close a+2 clear 1 -2 1
close y set 3 -1 1 minecraft:redstone_block
close y+2 clear 3 -1 1
close y+4 set 3 -1 1 minecraft:redstone_block
close y+6 clear 3 -1 1
close f set 0 -1 0 minecraft:redstone_block
close f+2 set 0 -1 0 minecraft:smooth_stone
close b1 set 1 -3 1 minecraft:redstone_block
close b1+2 clear 1 -3 1
close b2 set 1 -3 1 minecraft:redstone_block
close b2+2 clear 1 -3 1
