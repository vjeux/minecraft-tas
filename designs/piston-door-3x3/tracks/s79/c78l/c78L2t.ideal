# c78L2t: c78L2 with M SYMMETRIC (on 15..25 on both edges: a calibrated sensor window) and TP asymmetric (open 12, close 28).
design designs/piston-door-3x3/tracks/s79/c78l/c78L2.txt
let a2 = 12
let a3 = 15
let a4 = 18
let a5 = 25
let l = 12
let c5 = 28
let cl = 12
open 0 use 5 -1 0
open a2 set -1 3 -1 minecraft:redstone_block
open a2+2 clear -1 3 -1
open a3 set 2 5 0 minecraft:redstone_block
open a5 clear 2 5 0
open a4 set 1 3 -1 minecraft:redstone_block
open a4+2 clear 1 3 -1
open l set -2 2 -1 minecraft:redstone_block
open l+2 clear -2 2 -1
close 0 use 5 -1 0
close c5 set -1 3 -1 minecraft:redstone_block
close c5+2 clear -1 3 -1
close cl set -2 2 -1 minecraft:redstone_block
close cl+2 clear -2 2 -1
close a3 set 2 5 0 minecraft:redstone_block
close a5 clear 2 5 0
