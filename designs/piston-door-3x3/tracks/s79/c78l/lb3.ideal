# c78l lb3: lb2 with U's ideal input removed (U must be driven by the bottom-right cells (2,-2), (3,-2), (4,-2), (3,-1), lever on (4,-1)'s east face); K, L0, R0 real; top ideal (R1/R2 pulse, M level, s pushes), timed late so U's open retraction can come as late as t9.
design designs/piston-door-3x3/tracks/s79/c78l/lb3.txt
let r = 2
let cr = 2
let m = 26
let cm = 16
let e = 10
let eh = 4
let ce = 6
open 0 use 5 -1 0
open r set 4 2 -1 minecraft:redstone_block
open r+2 clear 4 2 -1
open m-1 clear 2 5 0
open e set 1 3 -1 minecraft:redstone_block
open e+eh clear 1 3 -1
close 0 use 5 -1 0
close cr set 4 2 -1 minecraft:redstone_block
close cr+2 clear 4 2 -1
close cm-1 set 2 5 0 minecraft:redstone_block
close ce set 1 4 -1 minecraft:redstone_block
close ce+2 clear 1 4 -1
