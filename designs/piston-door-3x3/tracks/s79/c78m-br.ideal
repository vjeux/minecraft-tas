# c78m with ONLY BR's puller (2,-2) ideal (c79's tick 3 pulse, both edges): U, K, L0 must come from
# real wiring (pockets / search screens: a filling that keeps the door working drives all three).
design designs/piston-door-3x3/tracks/s79/c78m.txt
let br = 2
open 0 use 4 6 0
open br set 2 -2 -1 minecraft:redstone_block
open br+2 clear 2 -2 -1
close 0 use 4 6 0
close br set 2 -2 -1 minecraft:redstone_block
close br+2 clear 2 -2 -1
