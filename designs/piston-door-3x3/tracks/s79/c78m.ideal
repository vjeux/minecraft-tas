# c79's mechanism in 7x8 (c78m.txt): lever + c79's top wiring real; BR's puller (2,-2), U (1,-2),
# K (-1,-1), L0 (-2,0) ideal, at c79's own ticks (a piston acts at tick t+1 after a plan event at t).
# Same-tick events apply in file order: K's and L0's before U's (c79: K's retraction is queued
# before U's second extension in tick 11).
design designs/piston-door-3x3/tracks/s79/c78m.txt
let br = 2
let u1 = 4
let u2 = 10
let k = 8
let l0 = 8
let w = 2
let cbr = 2
let cu1 = 4
let cu2 = 10
let ck = 8
let cl0 = 8
open 0 use 4 6 0
open br set 2 -2 -1 minecraft:redstone_block
open br+w clear 2 -2 -1
open k set -1 -1 -1 minecraft:redstone_block
open k+w clear -1 -1 -1
open l0 set -2 0 -1 minecraft:redstone_block
open l0+w clear -2 0 -1
open u1 set 1 -2 -1 minecraft:redstone_block
open u1+w clear 1 -2 -1
open u2 set 1 -2 -1 minecraft:redstone_block
open u2+w clear 1 -2 -1
close 0 use 4 6 0
close cbr set 2 -2 -1 minecraft:redstone_block
close cbr+w clear 2 -2 -1
close ck set -1 -1 -1 minecraft:redstone_block
close ck+w clear -1 -1 -1
close cl0 set -2 0 -1 minecraft:redstone_block
close cl0+w clear -2 0 -1
close cu1 set 1 -2 -1 minecraft:redstone_block
close cu1+w clear 1 -2 -1
close cu2 set 1 -2 -1 minecraft:redstone_block
close cu2+w clear 1 -2 -1
