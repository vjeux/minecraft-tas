# s79b p3: c78z with U driven by three pulses at the SAME plan ticks on both edges (what a bottom-right that only hears the door could give): a (width aw), a+g (width bw), z (width zw); R0 2 gt at r0.
design designs/piston-door-3x3/tracks/s79/c78z.txt
let a = 4
let aw = 2
let g = 3
let bw = 2
let z = 24
let zw = 2
let r0 = 4
open 0 use 4 6 0
open a set 1 -2 -1 minecraft:redstone_block
