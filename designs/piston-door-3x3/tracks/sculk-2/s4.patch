# s1 -> P_L moves down to (0,3,0) (pushes slime (-1,3,0); the slime (-1,4,0) and the rider go):
# its retracting base is now what blocks the right structure's early pull on close. K (0,3,-1)
# powers Q (above it) and P_L (south of it) directly; lever on K's west face; hold sensor at 0 5 -1.
clear 0 4 0
clear -1 4 0
set 0 3 0 minecraft:sticky_piston[extended=false,facing=west]
clear 0 5 -1
clear 0 6 -1
set 0 3 -1 minecraft:smooth_stone
set -1 3 -1 minecraft:lever[face=wall,facing=west,powered=false]
port lever -1 3 -1
set 0 5 -1 minecraft:sculk_sensor[power=0,sculk_sensor_phase=inactive,waterlogged=false]
