# u7-m10 plan (lever-off-at-rest convention): levels cleared at open / restored at close.
design designs/piston-door-3x3/tracks/sculk/seeds/m10i.txt
let r = 0
let ah0 = 2
let ah = 4
let tr = 8
let k = 8
let l0 = 8
let l12 = 12
let b = 10
let u = 10
let af = 12
let cr = 0
let ctr = 8
let cb = 10
let cl = 0
let cu1 = 0
let ck = 4
let cu2 = 12
