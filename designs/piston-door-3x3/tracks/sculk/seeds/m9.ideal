# u7-m9 symmetric plan: the same events on both edges. The A-hold is REAL (repeater (-1,3) into
# TL at (0,3)), fed by a redstone block at its back (-2,3); A's short pulse by a redstone block AT
# (2,4) (powers A at (1,4); at (1,3) it only QC-arms it without an update, like a conductor).
design designs/piston-door-3x3/tracks/sculk/seeds/m9.txt
let s = 0
let u1 = 2
let k = 8
let h = 12
let u2 = 22
let y = 34
let x = 42
open s set -2 1 -1 minecraft:redstone_block
open s+2 clear -2 1 -1
open s set 4 1 -1 minecraft:redstone_block
open s+2 clear 4 1 -1
open s set 4 2 -1 minecraft:redstone_block
open s+2 clear 4 2 -1
open s set 0 4 -1 minecraft:redstone_block
open s+2 clear 0 4 -1
open u1 set 1 -2 -1 minecraft:redstone_block
open u1+2 clear 1 -2 -1
open k set -1 -1 -1 minecraft:redstone_block
open k+2 clear -1 -1 -1
open h set -2 3 0 minecraft:redstone_block
open h+2 clear -2 3 0
open u2 set 1 -2 -1 minecraft:redstone_block
open u2+2 clear 1 -2 -1
open y set 1 5 -1 minecraft:redstone_block
open y+2 clear 1 5 -1
open x set 2 4 0 minecraft:redstone_block
open x+2 clear 2 4 0
close s set -2 1 -1 minecraft:redstone_block
close s+2 clear -2 1 -1
close s set 4 1 -1 minecraft:redstone_block
close s+2 clear 4 1 -1
close s set 4 2 -1 minecraft:redstone_block
close s+2 clear 4 2 -1
close s set 0 4 -1 minecraft:redstone_block
close s+2 clear 0 4 -1
close u1 set 1 -2 -1 minecraft:redstone_block
close u1+2 clear 1 -2 -1
close k set -1 -1 -1 minecraft:redstone_block
close k+2 clear -1 -1 -1
close h set -2 3 0 minecraft:redstone_block
close h+2 clear -2 3 0
close u2 set 1 -2 -1 minecraft:redstone_block
close u2+2 clear 1 -2 -1
close y set 1 5 -1 minecraft:redstone_block
close y+2 clear 1 5 -1
close x set 2 4 0 minecraft:redstone_block
close x+2 clear 2 4 0
