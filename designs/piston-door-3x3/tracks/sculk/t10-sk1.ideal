# t10s with A driven by the sculk lamp (no A events); E, B, TR, MR+BR, BL, BM ideal
let e = 6
let b1 = 12
let b2 = 24
let s = 40
open 0 use -3 2 0
close 0 use -3 2 0
open e set -1 3 1 minecraft:redstone_block
open e+2 clear -1 3 1
open b1 set 1 5 1 minecraft:redstone_block
open b1+2 clear 1 5 1
open b2 set 1 5 1 minecraft:redstone_block
open b2+2 clear 1 5 1
open s set 2 4 1 minecraft:redstone_block
open s+2 clear 2 4 1
open s set 4 1 1 minecraft:redstone_block
open s+2 clear 4 1 1
open s set 0 -2 1 minecraft:redstone_block
open s+2 clear 0 -2 1
open s set 1 -2 1 minecraft:redstone_block
open s+2 clear 1 -2 1
close e set -1 3 1 minecraft:redstone_block
close e+2 clear -1 3 1
close b1 set 1 5 1 minecraft:redstone_block
close b1+2 clear 1 5 1
close b2 set 1 5 1 minecraft:redstone_block
close b2+2 clear 1 5 1
close s set 2 4 1 minecraft:redstone_block
close s+2 clear 2 4 1
close s set 4 1 1 minecraft:redstone_block
close s+2 clear 4 1 1
close s set 0 -2 1 minecraft:redstone_block
close s+2 clear 0 -2 1
close s set 1 -2 1 minecraft:redstone_block
close s+2 clear 1 -2 1
