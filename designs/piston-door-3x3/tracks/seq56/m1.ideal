# m1 with ideal pulses (2 gt each). Open: A L B A B A + sides + bottom; close: A L A + sides + bottom.
design designs/piston-door-3x3/tracks/seq56/m1.txt
let g = 6
let ts = 0
let tb = 0
open 0 set 1 4 1 minecraft:redstone_block
open 2 clear 1 4 1
open g set -1 3 1 minecraft:redstone_block
open g+2 clear -1 3 1
open g+g set 1 5 1 minecraft:redstone_block
open g+g+2 clear 1 5 1
open g+g+g set 1 3 1 minecraft:redstone_block
open g+g+g+2 clear 1 3 1
open g+g+g+g set 1 5 1 minecraft:redstone_block
open g+g+g+g+2 clear 1 5 1
open g+g+g+g+g set 1 4 1 minecraft:redstone_block
open g+g+g+g+g+2 clear 1 4 1
open ts set -2 2 1 minecraft:redstone_block
open ts+2 clear -2 2 1
open ts set 4 2 1 minecraft:redstone_block
open ts+2 clear 4 2 1
open tb set 0 -2 1 minecraft:redstone_block
open tb+2 clear 0 -2 1
open tb set 1 -2 1 minecraft:redstone_block
open tb+2 clear 1 -2 1
open tb set 2 -2 1 minecraft:redstone_block
open tb+2 clear 2 -2 1
close 0 set 1 4 1 minecraft:redstone_block
close 2 clear 1 4 1
close g set -1 3 1 minecraft:redstone_block
close g+2 clear -1 3 1
close g+g set 1 4 1 minecraft:redstone_block
close g+g+2 clear 1 4 1
close ts set -2 2 1 minecraft:redstone_block
close ts+2 clear -2 2 1
close ts set 4 2 1 minecraft:redstone_block
close ts+2 clear 4 2 1
close tb set 0 -2 1 minecraft:redstone_block
close tb+2 clear 0 -2 1
close tb set 1 -2 1 minecraft:redstone_block
close tb+2 clear 1 -2 1
close tb set 2 -2 1 minecraft:redstone_block
close tb+2 clear 2 -2 1
