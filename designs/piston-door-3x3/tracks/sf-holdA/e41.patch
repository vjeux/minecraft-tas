# puller gets X's three pulses (t2, t14, t22), the left pair (watching TL's cell) follows.
clear 1 3 -1
set 1 4 -1 minecraft:smooth_stone
clear 0 4 -2
set 0 3 -1 minecraft:smooth_stone
