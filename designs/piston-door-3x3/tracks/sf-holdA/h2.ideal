# h1: pist19r with A held extended at rest by RB (1,4,1); Q (2,4,1) pulse pushes RB away (open)
design designs/piston-door-3x3/tracks/sf-holdA/h2-mech.txt
let a1 = 1     # A pulse 1 (A high, X): open swallowed (A held), close spits C down to (1,2)
let q = 5      # Q pulse: open pushes RB away (A lifts T), close pulls RB back (A on: T, C home)
let pt = 7     # P_T pulse: open pulls T to (0,3), close pushes it back to (1,3)
let bon = 11   # B window on (close: blocked by the extended A)
let a2 = 13    # A pulse 2 (A low)
let boff = 19  # B window off
let a3 = 21    # A pulse 3 (A high)
let pl = 5     # left column
let m = 5      # M (early!)
let pr = 5     # right pair
open a1 set 0 4 -1 minecraft:redstone_block
open a1+2 clear 0 4 -1
close a1 set 0 4 -1 minecraft:redstone_block
close a1+2 clear 0 4 -1
open q set 2 6 -1 minecraft:redstone_block
open q+2 clear 2 6 -1
close q set 2 6 -1 minecraft:redstone_block
close q+2 clear 2 6 -1
open pt set -1 4 0 minecraft:redstone_block
open pt+2 clear -1 4 0
close pt set -1 4 0 minecraft:redstone_block
close pt+2 clear -1 4 0
open bon set 1 6 0 minecraft:redstone_block
open boff clear 1 6 0
close bon set 1 6 0 minecraft:redstone_block
close boff clear 1 6 0
open a2 set 0 4 -1 minecraft:redstone_block
open a2+2 clear 0 4 -1
close a2 set 0 4 -1 minecraft:redstone_block
close a2+2 clear 0 4 -1
open a3 set 0 4 -1 minecraft:redstone_block
open a3+2 clear 0 4 -1
close a3 set 0 4 -1 minecraft:redstone_block
close a3+2 clear 0 4 -1
open pl set -2 -1 0 minecraft:redstone_block
open pl set -3 1 0 minecraft:redstone_block
open pl set -3 2 0 minecraft:redstone_block
open pl+2 clear -2 -1 0
open pl+2 clear -3 1 0
open pl+2 clear -3 2 0
close pl set -2 -1 0 minecraft:redstone_block
close pl set -3 1 0 minecraft:redstone_block
close pl set -3 2 0 minecraft:redstone_block
close pl+2 clear -2 -1 0
close pl+2 clear -3 1 0
close pl+2 clear -3 2 0
open m set 1 -3 0 minecraft:redstone_block
open m+2 clear 1 -3 0
close m set 1 -3 0 minecraft:redstone_block
close m+2 clear 1 -3 0
open pr set 4 -1 0 minecraft:redstone_block
open pr set 5 1 0 minecraft:redstone_block
open pr+2 clear 4 -1 0
open pr+2 clear 5 1 0
close pr set 4 -1 0 minecraft:redstone_block
close pr set 5 1 0 minecraft:redstone_block
close pr+2 clear 4 -1 0
close pr+2 clear 5 1 0
