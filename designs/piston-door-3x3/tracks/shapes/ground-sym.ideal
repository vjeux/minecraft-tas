# ground-sym: ground20 driven by ONE pulse train on both lever edges (the same events after the
# flip whether it opens or closes), found by `mech-synth --sym-bfs` on the middle column
# (bases/ground-mid.txt): 24 pulses, one every s ticks, plus the 6 side pistons at tick 0.
# Height-addressed power cells: A at 4/3/2: (1,4,-1)/(1,3,-1)/(1,2,-1); B at 5/4: (1,5,1)/(1,4,1);
# D: (1,6,1); P_T: (-1,4,0); P_C: (3,4,0); sides: (-3,y,0) and (5,y,0).
# S = A4 T D A3 T C C B4 D B5 C B5 T A2/A3 D T B4 A3 D B5 T C C A4
# `--set s=4` re-times every step (s = ticks between steps, w = pulse length).
design designs/piston-door-3x3/tracks/shapes/bases/ground20.txt
let s = 6
let w = 2
let t1 = s
let t2 = t1+s
let t3 = t2+s
let t4 = t3+s
let t5 = t4+s
let t6 = t5+s
let t7 = t6+s
let t8 = t7+s
let t9 = t8+s
let t10 = t9+s
let t11 = t10+s
let t12 = t11+s
let t13 = t12+s
let t14 = t13+s
let t15 = t14+s
let t16 = t15+s
let t17 = t16+s
let t18 = t17+s
let t19 = t18+s
let t20 = t19+s
let t21 = t20+s
let t22 = t21+s
let t23 = t22+s
let t24 = t23+s
# step 0: sides
open 0 set -3 0 0 minecraft:redstone_block
open 0 set -3 1 0 minecraft:redstone_block
open 0 set -3 2 0 minecraft:redstone_block
open 0 set 5 0 0 minecraft:redstone_block
open 0 set 5 1 0 minecraft:redstone_block
open 0 set 5 2 0 minecraft:redstone_block
open w clear -3 0 0
open w clear -3 1 0
open w clear -3 2 0
open w clear 5 0 0
open w clear 5 1 0
open w clear 5 2 0
close 0 set -3 0 0 minecraft:redstone_block
close 0 set -3 1 0 minecraft:redstone_block
close 0 set -3 2 0 minecraft:redstone_block
close 0 set 5 0 0 minecraft:redstone_block
close 0 set 5 1 0 minecraft:redstone_block
close 0 set 5 2 0 minecraft:redstone_block
close w clear -3 0 0
close w clear -3 1 0
close w clear -3 2 0
close w clear 5 0 0
close w clear 5 1 0
close w clear 5 2 0
