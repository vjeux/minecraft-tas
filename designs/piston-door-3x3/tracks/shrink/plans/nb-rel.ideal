design designs/piston-door-3x3/tracks/shrink/wip/t7b-nobottom.txt
open 0 use 1 5 0
close 0 use 1 5 0
# P_M pulse
open pm set -1 -1 1 minecraft:redstone_block
open pm+2 clear -1 -1 1
close pm set -1 -1 1 minecraft:redstone_block
close pm+2 clear -1 -1 1
# B hold
open b set 1 -3 1 minecraft:redstone_block
open b+bw clear 1 -3 1
close b set 1 -3 1 minecraft:redstone_block
close b+bw clear 1 -3 1
# A pulse 0
open a set 1 -2 1 minecraft:redstone_block
open a+2 clear 1 -2 1
close a set 1 -2 1 minecraft:redstone_block
close a+2 clear 1 -2 1
# gate pulses (open only)
open b+d1 set 1 -1 1 minecraft:redstone_block
open b+d1+2 clear 1 -1 1
open b+bw+d2 set 1 -2 1 minecraft:redstone_block
open b+bw+d2+2 clear 1 -2 1
let pm = 19
let b = 25
let bw = 8
let a = 11
let d1 = 2
let d2 = 2
