# Ideal-input mechanism for the "A steady, B blocked on close" study (from the 48): every control
# block removed except X (2,4,0) + its floor (2,3,0); A extended at rest, held by a redstone block
# at (1,4,-1); P_T held by a redstone block at (1,3,3). The lever keeps a plain support.
set 5 3 0 minecraft:smooth_stone
clear 5 2 0
clear 5 1 0
clear 0 3 2
clear 0 4 2
clear 0 4 1
clear -1 2 0
clear -2 2 0
clear 2 -1 0
clear 2 -2 0
clear 4 4 0
clear 3 4 0
clear 4 5 0
clear 4 6 0
clear 3 6 0
clear 2 6 0
clear 2 5 0
clear 5 4 1
clear 5 3 1
clear 5 4 2
clear 4 4 2
clear 4 3 2
clear 3 4 1
clear 3 3 1
clear 3 4 2
clear 2 4 2
clear 1 4 0
set 1 4 0 minecraft:sticky_piston[extended=true,facing=down]
set 1 4 -1 minecraft:redstone_block
set 1 3 3 minecraft:redstone_block
