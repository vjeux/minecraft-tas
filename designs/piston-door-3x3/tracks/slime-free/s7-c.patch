# left column of 3 fired by a cross dust (-2,2,1) on (-2,1,1) (points north into the top piston, its floor powers the middle and quasi-powers the bottom), fed by an observer chain from RB's open cell
clear -1 4 0
clear -2 4 0
clear -2 3 0
set -1 4 1 minecraft:observer[facing=east,powered=false]
set -2 4 1 minecraft:observer[facing=east,powered=false]
set -2 3 1 minecraft:observer[facing=up,powered=false]
set -2 1 1 minecraft:smooth_stone
set -2 2 1 minecraft:redstone_wire[east=side,north=side,power=0,south=side,west=side]
