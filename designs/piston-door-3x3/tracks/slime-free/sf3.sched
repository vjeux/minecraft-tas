# sf2: RB south of A, Q pulls on open / pushes on close; Q's pulse may come later on close (lamp).
design designs/piston-door-3x3/tracks/slime-free/sf3-ideal.txt
let s = 1
let q = 2
let qc = 6
let pt = 6
let ptc = 6
let p0 = 0
let b = 12
let bw = 8
let dx = 2
open s set -1 4 0 minecraft:redstone_block
open s set 3 4 0 minecraft:redstone_block
open s set -2 2 0 minecraft:redstone_block
open s set 4 2 0 minecraft:redstone_block
open s set 2 -2 0 minecraft:redstone_block
open s+2 clear -1 4 0
open s+2 clear 3 4 0
open s+2 clear -2 2 0
open s+2 clear 4 2 0
open s+2 clear 2 -2 0
open q set 1 4 4 minecraft:redstone_block
open q+2 clear 1 4 4
open pt set 1 3 -3 minecraft:redstone_block
open pt+2 clear 1 3 -3
open p0 set 1 4 -2 minecraft:stone
open b set 1 6 0 minecraft:redstone_block
open b+bw clear 1 6 0
open b+dx set 1 3 2 minecraft:stone
open b+bw+dx clear 1 4 -2
close s set -1 4 0 minecraft:redstone_block
close s set 3 4 0 minecraft:redstone_block
close s set -2 2 0 minecraft:redstone_block
close s set 4 2 0 minecraft:redstone_block
close s set 2 -2 0 minecraft:redstone_block
close s+2 clear -1 4 0
close s+2 clear 3 4 0
close s+2 clear -2 2 0
close s+2 clear 4 2 0
close s+2 clear 2 -2 0
close qc set 1 4 4 minecraft:redstone_block
close qc+2 clear 1 4 4
close ptc set 1 3 -3 minecraft:redstone_block
close ptc+2 clear 1 3 -3
close p0 set 1 4 -2 minecraft:stone
close p0+24 clear 1 4 -2
close p0+26 clear 1 3 2
