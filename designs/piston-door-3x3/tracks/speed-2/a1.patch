# a1 = o7s + open-10 control: no Q hold (Q spits A' at k6); A' power k5..k7 via a repeater reading
# R_F's rest spot (off k3) -> note block -> observer -> stone X next to E; Q k8..k10 via repeater
# off the k2 pulse -> observer -> note block -> observer into Q's QC cell.
clear -2 4 -1
set 1 3 -1 minecraft:stone
set 1 3 -2 minecraft:observer[facing=north,powered=false]
set 1 4 -2 minecraft:repeater[delay=1,facing=south,locked=false,powered=true]
set 1 4 -3 minecraft:stone
set 1 3 -3 minecraft:note_block
set -3 3 -2 minecraft:stone
set -3 4 -2 minecraft:repeater[delay=1,facing=east,locked=false,powered=false]
set -3 4 -1 minecraft:observer[facing=north,powered=false]
set -3 4 0 minecraft:note_block
set -2 4 0 minecraft:observer[facing=west,powered=false]
