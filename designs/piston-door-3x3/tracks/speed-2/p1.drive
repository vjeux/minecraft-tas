design designs/piston-door-3x3/tracks/speed-2/p1.txt
# p1 scripted: P_D/P_V pulse k4..k6 (R_X lands k6 BE, R_Z k8 BE), A' power k5..k6 at (1,3,1),
# Q power k9 at (-1,4,0). Expect N1 clear at k10 (t=12).
probe F 1 4 0
probe E 1 3 0
probe N1 1 2 0
probe C 1 1 0
probe Ap 0 3 0
probe Q -1 3 0
probe PX 1 5 0
probe R1 1 5 1
probe RZ 1 6 1
quiet 2
use 0 4 -2
trace 3
set 1 6 3 minecraft:redstone_block
set 2 7 1 minecraft:redstone_block
trace 1
set 1 3 1 minecraft:redstone_block
trace 1
clear 1 6 3
clear 2 7 1
trace 1
clear 1 3 1
trace 2
set -1 4 0 minecraft:redstone_block
trace 1
clear -1 4 0
trace 8
