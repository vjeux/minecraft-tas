# Relaxed ideal schedule for ideal-2 (1-tick pulses where the real thing wants 0-ticks).
design designs/piston-door-3x3/tracks/speed/ideal-2.txt
let q_on = 3
let a_on = 6
let q_off = 10
# open: rest pistons (F, sides, M) lose power at the flip
open 0 clear 1 5 0
open 0 clear -3 0 0
open 0 clear -3 1 0
open 0 clear -3 2 0
open 0 clear 5 0 0
open 0 clear 5 1 0
open 0 clear 5 2 0
open 0 clear 1 -3 0
open q_on set 2 3 2 minecraft:redstone_block
open a_on set 2 3 0 minecraft:redstone_block
open a_on+1 clear 2 3 0
open q_off clear 2 3 2
open q_off set 1 5 0 minecraft:redstone_block
open q_off+1 clear 1 5 0
# close
close 0 set 1 5 0 minecraft:redstone_block
close 0 set -3 0 0 minecraft:redstone_block
close 0 set -3 1 0 minecraft:redstone_block
close 0 set -3 2 0 minecraft:redstone_block
close 0 set 5 0 0 minecraft:redstone_block
close 0 set 5 1 0 minecraft:redstone_block
close 0 set 5 2 0 minecraft:redstone_block
close 0 set 1 -3 0 minecraft:redstone_block
close 1 clear 1 5 0
close 2 set 1 3 -3 minecraft:redstone_block
close 3 clear 1 3 -3
close 3 set 1 5 0 minecraft:redstone_block
