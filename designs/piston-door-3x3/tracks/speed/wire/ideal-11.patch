# ideal-11: sides and M on torches (off while the lever is on). Attachments (-4,1,0), (6,1,0),
# (1,-4,0) get powered by the lever net (routed separately).
set -3 0 0 minecraft:air
set -3 1 0 minecraft:redstone_wall_torch[facing=east,lit=true]
set -3 2 0 minecraft:stone
set -4 1 0 minecraft:stone
set 5 0 0 minecraft:air
set 5 1 0 minecraft:redstone_wall_torch[facing=west,lit=true]
set 5 2 0 minecraft:stone
set 6 1 0 minecraft:stone
set 1 -3 0 minecraft:redstone_torch[lit=true]
set 1 -4 0 minecraft:stone
# lever net start: dust next to the lever's floor block (0,3,-2)
set -1 3 -2 minecraft:redstone_wire[east=side,north=none,power=0,south=none,west=side]
set -1 2 -2 minecraft:smooth_stone
