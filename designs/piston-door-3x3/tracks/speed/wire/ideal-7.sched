design designs/piston-door-3x3/tracks/speed/wire/ideal-7.txt
# F's reach-through is real (observer O5 into (1,5,0) at k=10..12). Q: noisy on at q_on (block
# next to Q), silent QC hold (block at (-1,5,0), not adjacent to Q) dropped at h_off; A' landing
# at k=10 updates Q (through its head) -> Q pulls A' at k=11.
let q_on = 3
let h_on = 4
let n_off = 5
let h_off = 9
open 0 set 1 3 4 minecraft:lever[face=floor,facing=north,powered=true]
open 0 clear 1 4 -1
open 0 clear -3 0 0
open 0 clear -3 1 0
open 0 clear -3 2 0
open 0 clear 5 0 0
open 0 clear 5 1 0
open 0 clear 5 2 0
open 0 clear 1 -3 0
open q_on set -1 3 -1 minecraft:redstone_block
open h_on set -1 5 0 minecraft:redstone_block
open n_off clear -1 3 -1
open h_off clear -1 5 0
close 0 set 1 3 4 minecraft:lever[face=floor,facing=north,powered=false]
close 0 set 1 4 -1 minecraft:redstone_block
close 0 set -3 0 0 minecraft:redstone_block
close 0 set -3 1 0 minecraft:redstone_block
close 0 set -3 2 0 minecraft:redstone_block
close 0 set 5 0 0 minecraft:redstone_block
close 0 set 5 1 0 minecraft:redstone_block
close 0 set 5 2 0 minecraft:redstone_block
close 0 set 1 -3 0 minecraft:redstone_block
close 1 clear 1 4 -1
close 2 set 3 4 0 minecraft:redstone_block
close 3 clear 3 4 0
close 3 set 1 4 -1 minecraft:redstone_block
