# k6..k8 pulses scripted with redstone blocks behind P_D (1,5,4) and P_V (-1,6,1), both edges.
probe F 1 4 0
probe E 1 3 0
probe N1 1 2 0
probe PX 1 5 0
probe R1 1 5 1
probe R2 1 5 2
probe PD 1 5 3
probe PV 0 6 1
probe Z1 1 6 1
probe Z2 2 6 1
quiet 2
use 0 4 -2
trace 5
set 1 5 4 minecraft:redstone_block
set -1 6 1 minecraft:redstone_block
trace 2
clear 1 5 4
clear -1 6 1
trace 12
use 0 4 -2
trace 5
set 1 5 4 minecraft:redstone_block
set -1 6 1 minecraft:redstone_block
trace 2
clear 1 5 4
clear -1 6 1
trace 10
