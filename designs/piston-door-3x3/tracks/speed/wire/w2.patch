# w2 = w1 + faster close: F spit at k=6 (observer (1,4,1) into F, fed by the W pulse net
# extended south), TR back to k=10, S_R at k=8 (chain off the lever net dust (3,3,-5)).
# TR chain k6 (2,3,-2) -> k8 (3,3,-2) -> k10 (3,3,-1)
clear 2 3 -3
set 3 3 -2 minecraft:observer[facing=west,powered=false]
# S_R chain: X1 (3,3,-4) watches lever-net dust (3,3,-5) k2 -> X2 (3,3,-3) k4 -> X3 (3,4,-3) k6 -> X4 (3,4,-2) k8 -> S_R
set 3 3 -4 minecraft:observer[facing=north,powered=false]
set 3 3 -3 minecraft:observer[facing=north,powered=false]
# east branch repeater moved after (3,3,-5) so that dust changes at k=0
set 2 3 -5 minecraft:redstone_wire
set 4 3 -5 minecraft:redstone_wire
set 6 1 -4 minecraft:repeater[delay=1,facing=north,locked=false,powered=false]
# W pulse net extended south to (1,4,3); (1,4,2) k4, (1,4,1) k6 -> F
set -3 4 1 minecraft:smooth_stone
set -3 5 1 minecraft:redstone_wire
set -3 4 2 minecraft:smooth_stone
set -3 5 2 minecraft:redstone_wire
set -3 4 3 minecraft:smooth_stone
set -3 5 3 minecraft:redstone_wire
set -2 4 3 minecraft:smooth_stone
set -2 5 3 minecraft:redstone_wire
set -1 4 3 minecraft:smooth_stone
set -1 5 3 minecraft:redstone_wire
set 0 4 3 minecraft:smooth_stone
set 0 5 3 minecraft:redstone_wire
set 1 3 3 minecraft:smooth_stone
set 1 4 3 minecraft:redstone_wire
set 1 4 2 minecraft:observer[facing=south,powered=false]
set 1 4 1 minecraft:observer[facing=south,powered=false]
