# t78 o3: b0 + O3 = observer (0,-3) facing east watching B (the gate observer (0,-2) watches O3);
# ideal: P_M pulse at pm, B two 2gt pulses p1 (lift + spit) and p2 (reach-through lower)
design designs/piston-door-3x3/tracks/t78/wip/b0.txt
let pm = 18
let p1 = 24
let p2 = 34
open 0 use 1 5 0
close 0 use 1 5 0
open pm set -1 -1 1 minecraft:redstone_block
open pm+2 clear -1 -1 1
close pm set -1 -1 1 minecraft:redstone_block
close pm+2 clear -1 -1 1
open p1 set 1 -3 1 minecraft:redstone_block
open p1+2 clear 1 -3 1
close p1 set 1 -3 1 minecraft:redstone_block
close p1+2 clear 1 -3 1
open p2 set 1 -3 1 minecraft:redstone_block
open p2+2 clear 1 -3 1
close p2 set 1 -3 1 minecraft:redstone_block
close p2+2 clear 1 -3 1
