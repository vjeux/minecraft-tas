# t78 r70-s1: only (4,0)'s pulse and the bottom pullers ideal
design designs/piston-door-3x3/tracks/t78/r70/r70-s1.txt
let r0 = 3
let bp = 20
open 0 use 5 2 0
open r0 set 4 0 1 minecraft:redstone_block
open r0+2 clear 4 0 1
open bp set 0 -2 1 minecraft:redstone_block
open bp set 1 -2 1 minecraft:redstone_block
open bp+2 clear 0 -2 1
open bp+2 clear 1 -2 1
close 0 use 5 2 0
close r0 set 4 0 1 minecraft:redstone_block
close r0+2 clear 4 0 1
close bp set 0 -2 1 minecraft:redstone_block
close bp set 1 -2 1 minecraft:redstone_block
close bp+2 clear 0 -2 1
close bp+2 clear 1 -2 1
