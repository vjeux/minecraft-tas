# Ideal schedule for o4b: open 4 (0-tick modules in the world), close by scripted pulses.
design designs/piston-door-3x3/tracks/tick-door/o4b.txt
# open: S_TR shoves R_TR (P_TR retracts k1), K_W/K_A armed, blockers off, L/BL pullers off
open 0 set 2 5 2 minecraft:redstone_block
open 0 set 3 2 2 minecraft:redstone_block
open 0 set 1 4 -2 minecraft:redstone_block
open 0 clear 4 5 1
open 0 clear 1 7 -1
open 0 clear -3 0 0
open 0 clear -3 1 0
# Q and P_WN: pull-type pulses k2..k4
open 1 set -1 4 0 minecraft:redstone_block
open 1 set 3 3 -2 minecraft:redstone_block
open 3 clear -1 4 0
open 3 clear 3 3 -2
# K_F, K_V armed silently for k4; ring pullers off at k4
open 3 set 1 7 0 minecraft:redstone_block
open 3 set 6 3 0 minecraft:redstone_block
open 3 clear 1 -3 0
open 3 clear -3 2 0
open 3 clear 4 0 0
open 3 clear 2 -3 0
# close: F spits C into N1, V spits T into (2,2) (k1..k2); ring back
close 0 set 1 4 1 minecraft:redstone_block
close 0 set 4 2 1 minecraft:redstone_block
close 0 set -3 0 0 minecraft:redstone_block
close 0 set -3 1 0 minecraft:redstone_block
close 0 set -3 2 0 minecraft:redstone_block
close 0 set 1 -3 0 minecraft:redstone_block
close 0 set 2 -3 0 minecraft:redstone_block
close 0 set 4 0 0 minecraft:redstone_block
close 1 clear 1 4 1
close 1 clear 4 2 1
# P_WN returns W, Q returns A' (k3..k4, spits)
close 2 set 3 3 -2 minecraft:redstone_block
close 2 set -1 4 0 minecraft:redstone_block
close 3 clear 3 3 -2
close 3 clear -1 4 0
close 3 set 1 3 1 minecraft:redstone_block
# A' pushes C to the center (k4..k5), W pushes T into N1 (k5..k6), P_TR pushes TR home (k6)
close 4 clear 1 3 1
close 4 set 3 2 -1 minecraft:redstone_block
close 5 clear 3 2 -1
close 5 set 2 4 -1 minecraft:redstone_block
# resets
close 8 clear 6 3 0
close 8 clear 3 2 2
close 8 clear 2 5 2
close 8 clear 1 7 0
close 8 set 0 5 0 minecraft:stone
close 9 clear 0 5 0
close 12 clear 2 4 -1
close 12 set 4 5 1 minecraft:redstone_block
close 12 clear 1 4 -2
close 16 set 1 7 -1 minecraft:redstone_block
