# WIDE module, ideal inputs: every column gets b38's center-column waveforms (measured with
# b38-center-waves.drive). Event tick = the tick before the piston reacts.
design designs/piston-door-3x3/tracks/tile/wide-mech.txt
let a1 = 1
let a2 = 13
let a3 = 21
let e1 = 5
let b0 = 11
let b1 = 19
# ---- open ----
open a1 set 0 4 1 minecraft:redstone_block
open a1 set 1 4 1 minecraft:redstone_block
open a1 set 2 4 1 minecraft:redstone_block
open a1+2 clear 0 4 1
open a1+2 clear 1 4 1
open a1+2 clear 2 4 1
open e1 set 0 3 -3 minecraft:redstone_block
open e1 set 1 3 -3 minecraft:redstone_block
open e1 set 2 3 -3 minecraft:redstone_block
open e1+2 clear 0 3 -3
open e1+2 clear 1 3 -3
open e1+2 clear 2 3 -3
open b0 set 0 5 1 minecraft:redstone_block
open b0 set 1 5 1 minecraft:redstone_block
open b0 set 2 5 1 minecraft:redstone_block
open b1 clear 0 5 1
open b1 clear 1 5 1
open b1 clear 2 5 1
open a2 set 0 3 1 minecraft:redstone_block
open a2 set 1 3 1 minecraft:redstone_block
open a2 set 2 3 1 minecraft:redstone_block
open a2+2 clear 0 3 1
open a2+2 clear 1 3 1
open a2+2 clear 2 3 1
open a3 set 0 4 1 minecraft:redstone_block
open a3 set 1 4 1 minecraft:redstone_block
open a3 set 2 4 1 minecraft:redstone_block
open a3+2 clear 0 4 1
open a3+2 clear 1 4 1
open a3+2 clear 2 4 1
# ---- close ----
close a1 set 0 4 1 minecraft:redstone_block
close a1 set 1 4 1 minecraft:redstone_block
close a1 set 2 4 1 minecraft:redstone_block
close a1+2 clear 0 4 1
close a1+2 clear 1 4 1
close a1+2 clear 2 4 1
close e1 set 0 3 -3 minecraft:redstone_block
close e1 set 1 3 -3 minecraft:redstone_block
close e1 set 2 3 -3 minecraft:redstone_block
close e1+2 clear 0 3 -3
close e1+2 clear 1 3 -3
close e1+2 clear 2 3 -3
close b0 set 0 5 1 minecraft:redstone_block
close b0 set 1 5 1 minecraft:redstone_block
close b0 set 2 5 1 minecraft:redstone_block
close b1 clear 0 5 1
close b1 clear 1 5 1
close b1 clear 2 5 1
close a2 set 0 3 1 minecraft:redstone_block
close a2 set 1 3 1 minecraft:redstone_block
close a2 set 2 3 1 minecraft:redstone_block
close a2+2 clear 0 3 1
close a2+2 clear 1 3 1
close a2+2 clear 2 3 1
close a3 set 0 4 1 minecraft:redstone_block
close a3 set 1 4 1 minecraft:redstone_block
close a3 set 2 4 1 minecraft:redstone_block
close a3+2 clear 0 4 1
close a3+2 clear 1 4 1
close a3+2 clear 2 4 1
# symmetric F: the same two pulses on both edges
let f1 = 9
let f2 = 21
open f1 set 0 -3 0 minecraft:redstone_block
open f1 set 1 -3 0 minecraft:redstone_block
open f1 set 2 -3 0 minecraft:redstone_block
open f1+2 clear 0 -3 0
open f1+2 clear 1 -3 0
open f1+2 clear 2 -3 0
open f2 set 0 -3 0 minecraft:redstone_block
open f2 set 1 -3 0 minecraft:redstone_block
open f2 set 2 -3 0 minecraft:redstone_block
open f2+2 clear 0 -3 0
open f2+2 clear 1 -3 0
open f2+2 clear 2 -3 0
close f1 set 0 -3 0 minecraft:redstone_block
close f1 set 1 -3 0 minecraft:redstone_block
close f1 set 2 -3 0 minecraft:redstone_block
close f1+2 clear 0 -3 0
close f1+2 clear 1 -3 0
close f1+2 clear 2 -3 0
close f2 set 0 -3 0 minecraft:redstone_block
close f2 set 1 -3 0 minecraft:redstone_block
close f2 set 2 -3 0 minecraft:redstone_block
close f2+2 clear 0 -3 0
close f2+2 clear 1 -3 0
close f2+2 clear 2 -3 0
