# vd1L: vd1 with level-held pullers (vd1L.txt). Same order on both edges; levels flip, pulses fire.
# t0 TL's puller, t6 E1 (at (0,3) on open, (0,4) on close), t12 E2 (level), t18 E1 (at (0,4) / (0,3)),
# t24 E1c, t30 BM's side puller (level), t36 E2c, t42 E1c at (1,-1), t48 E2c, t54 E1c, t60 BL's
# puller (level), t66 TM's, t72 TR's, t78 MR's + BR's (levels).
design designs/piston-door-3x3/tracks/vmid/mech/vd1L.txt
let w = 2
open 0 clear -2 2 1
open 6 set 0 3 1 minecraft:redstone_block
open 6+w clear 0 3 1
open 12 clear 0 5 1
open 18 set 0 4 1 minecraft:redstone_block
open 18+w clear 0 4 1
open 24 set 1 -2 1 minecraft:redstone_block
open 24+w clear 1 -2 1
open 30 clear 3 -1 1
open 36 set 1 -3 1 minecraft:redstone_block
open 36+w clear 1 -3 1
open 42 set 1 -1 1 minecraft:redstone_block
open 42+w clear 1 -1 1
open 48 set 1 -3 1 minecraft:redstone_block
open 48+w clear 1 -3 1
open 54 set 1 -2 1 minecraft:redstone_block
open 54+w clear 1 -2 1
open 60 clear 0 -2 1
open 66 clear 1 4 1
open 72 clear 2 4 1
open 78 clear 4 1 1
close 0 set -2 2 1 minecraft:redstone_block
close 6 set 0 4 1 minecraft:redstone_block
close 6+w clear 0 4 1
close 12 set 0 5 1 minecraft:redstone_block
close 18 set 0 3 1 minecraft:redstone_block
close 18+w clear 0 3 1
close 24 set 1 -2 1 minecraft:redstone_block
close 24+w clear 1 -2 1
close 30 set 3 -1 1 minecraft:redstone_block
close 36 set 1 -3 1 minecraft:redstone_block
close 36+w clear 1 -3 1
close 42 set 1 -1 1 minecraft:redstone_block
close 42+w clear 1 -1 1
close 48 set 1 -3 1 minecraft:redstone_block
close 48+w clear 1 -3 1
close 54 set 1 -2 1 minecraft:redstone_block
close 54+w clear 1 -2 1
close 60 set 0 -2 1 minecraft:redstone_block
close 66 set 1 4 1 minecraft:redstone_block
close 72 set 2 4 1 minecraft:redstone_block
close 78 set 4 1 1 minecraft:redstone_block
