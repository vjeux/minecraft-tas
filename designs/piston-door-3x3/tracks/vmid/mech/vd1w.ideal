# vd1w: vd1 with connect's witness orders. Close: TL's puller fires 3 times (push TL home = wake-up
# for the top-left, pull it out again, push it home after ML is down); the center comes back with
# two pushes of (1,-2) around BM's return: (1,-2) pushes C up to (1,0), (3,-1) pushes BM back to
# (1,-1), (1,-2) pushes BM and C up together.
design designs/piston-door-3x3/tracks/vmid/mech/vd1.txt
let w = 2
# open: TLp, BLp, E2, E1@(0,3), E2, E1, TMp, TRp, MRp(+BRp), E1c, BMs, E2c, E1c@(1,-1), E2c, E1c
