# w63top lamp plan (every input OFF the door plane, for cosearch --assist): A1 = z, P_T pre z-2
# + real z+pt (held z-2..z+6 on open: the BUD timing of a QC-armed P_T), B1 z+b1, A2 z+a2,
# B2 z+b2, A3 z+a3 (the lamp's off edge), the right stack as a run of 3 (z-8, z-2, z+4),
# U at z+u, the left triple from z+t0.
design designs/piston-door-3x3/tracks/w63top/w63t-2f.txt
let z = 14
let pt = 4
let b1 = 8
let a2 = 12
let b2 = 16
let a3 = 30
let u = 40
let t0 = 44
let g = 6
open z-2 set 3 3 1 minecraft:redstone_block
open z clear 3 3 1
open z+pt set 3 3 1 minecraft:redstone_block
open z+pt+2 clear 3 3 1
open z-8 set 4 2 1 minecraft:redstone_block
open z-6 clear 4 2 1
open z-2 set 4 2 -1 minecraft:redstone_block
open z clear 4 2 -1
open z+4 set 4 2 1 minecraft:redstone_block
open z+6 clear 4 2 1
open z set 1 4 1 minecraft:redstone_block
open z+2 clear 1 4 1
open z+b1 set 1 5 -1 minecraft:redstone_block
open z+b1+2 clear 1 5 -1
open z+a2 set 1 3 1 minecraft:redstone_block
open z+a2+2 clear 1 3 1
open z+b2 set 1 5 -1 minecraft:redstone_block
open z+b2+2 clear 1 5 -1
open z+a3 set 1 4 1 minecraft:redstone_block
open z+a3+2 clear 1 4 1
open z+u set 0 4 1 minecraft:redstone_block
open z+u+2 clear 0 4 1
open z+t0 set -2 1 1 minecraft:redstone_block
open z+t0+2 clear -2 1 1
open z+t0+g set -2 1 1 minecraft:redstone_block
open z+t0+g+2 clear -2 1 1
open z+t0+g+g set -2 1 1 minecraft:redstone_block
open z+t0+g+g+2 clear -2 1 1
close z-2 set 3 3 1 minecraft:redstone_block
close z clear 3 3 1
close z+pt set 3 3 1 minecraft:redstone_block
close z+pt+2 clear 3 3 1
close z-8 set 4 2 1 minecraft:redstone_block
close z-6 clear 4 2 1
close z-2 set 4 2 -1 minecraft:redstone_block
close z clear 4 2 -1
close z+4 set 4 2 1 minecraft:redstone_block
close z+6 clear 4 2 1
close z set 1 4 1 minecraft:redstone_block
close z+2 clear 1 4 1
close z+b1 set 1 5 -1 minecraft:redstone_block
close z+b1+2 clear 1 5 -1
close z+a2 set 1 3 1 minecraft:redstone_block
close z+a2+2 clear 1 3 1
close z+b2 set 1 5 -1 minecraft:redstone_block
close z+b2+2 clear 1 5 -1
close z+a3 set 1 4 1 minecraft:redstone_block
close z+a3+2 clear 1 4 1
close z+u set 0 4 1 minecraft:redstone_block
close z+u+2 clear 0 4 1
close z+t0 set -2 1 1 minecraft:redstone_block
close z+t0+2 clear -2 1 1
close z+t0+g set -2 1 1 minecraft:redstone_block
close z+t0+g+2 clear -2 1 1
close z+t0+g+g set -2 1 1 minecraft:redstone_block
close z+t0+g+g+2 clear -2 1 1
