# v2 plan: P_T and the right stack fire TOGETHER (one conductor at (4,3)) as a run of 3, 6 gt
# apart: two harmless early P_T pulses (z-10, z-4) and the real one at z+pt (pt = 2); A single
# pulses (A1 z, A2 z+a2, A3 z+a3) from a separate chain; B, U, left triple as before.
design designs/piston-door-3x3/tracks/w63top/w63t-2.txt
let z = 14
let pt = 2
let b1 = 10
