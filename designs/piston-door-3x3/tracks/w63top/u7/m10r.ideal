# u7-m10 with A's hold RELAYED by TR: TRp's level drops first (tr), TR lands in (2,3); a real
# repeater (3,3) (delay 2, on the static frame stone (3,2)) fed at its back (4,3) by an ideal pulse
# at hs powers TR, which powers A at (1,3) for 4 gt. B, K, U, A's last pull shifted after it.
design designs/piston-door-3x3/tracks/w63top/u7/m10ri.txt
let r = 0
let tr = 0
let hs = 4
let tr2 = 0
let k = 14
let l0 = 8
let l12 = 12
let b = 16
let u = 16
let af = 20
let cr = 0
let ctr = 8
let cb = 10
let cl = 0
let cu1 = 0
let ck = 4
let cu2 = 12
open r clear 4 1 1
open tr clear 2 4 1
open hs set 4 3 0 minecraft:redstone_block
open hs+2 clear 4 3 0
open k set -1 -1 -1 minecraft:redstone_block
open k+2 clear -1 -1 -1
open l0 set -2 0 -1 minecraft:redstone_block
open l0+2 clear -2 0 -1
open l12 set -2 2 -1 minecraft:redstone_block
open l12+2 clear -2 2 -1
open b clear 1 5 1
open u set 1 -2 -1 minecraft:redstone_block
open u+2 clear 1 -2 -1
open af set 1 4 -1 minecraft:redstone_block
open af+2 clear 1 4 -1
close cr set 4 1 1 minecraft:redstone_block
close ctr set 2 4 1 minecraft:redstone_block
close cb set 1 5 1 minecraft:redstone_block
close cl set -2 0 -1 minecraft:redstone_block
close cl+2 clear -2 0 -1
close cl set -2 2 -1 minecraft:redstone_block
close cl+2 clear -2 2 -1
close cu1 set 1 -2 -1 minecraft:redstone_block
close cu1+2 clear 1 -2 -1
close ck set -1 -1 -1 minecraft:redstone_block
close ck+2 clear -1 -1 -1
close cu2 set 1 -2 -1 minecraft:redstone_block
close cu2+2 clear 1 -2 -1
