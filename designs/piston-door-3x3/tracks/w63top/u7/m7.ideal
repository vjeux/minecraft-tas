# u7-m7 (single U, 7x8, full frame): levels cleared at open / restored at close (sides at s, U at
# uu, P at z+pt), the elevator pulsed (A at (1,4,-1)/(1,3,-1), B at (1,5,-1)) like w63's top.
design designs/piston-door-3x3/tracks/w63top/u7/m7i.txt
let s = 0
let z = 4
let pt = 6
let b1 = 10
let a2 = 16
let b2 = 22
let a3 = 28
let uu = 40
open s clear -2 0 1
open s clear -2 1 1
open s clear -2 2 1
open s clear 4 0 1
open s clear 4 1 1
open s clear 4 2 1
open uu clear 1 -2 1
open z+pt clear 3 3 1
open z set 1 4 -1 minecraft:redstone_block
open z+2 clear 1 4 -1
open z+b1 set 1 5 -1 minecraft:redstone_block
open z+b1+2 clear 1 5 -1
open z+a2 set 1 3 -1 minecraft:redstone_block
open z+a2+2 clear 1 3 -1
open z+b2 set 1 5 -1 minecraft:redstone_block
open z+b2+2 clear 1 5 -1
open z+a3 set 1 4 -1 minecraft:redstone_block
open z+a3+2 clear 1 4 -1
close s set -2 0 1 minecraft:redstone_block
close s set -2 1 1 minecraft:redstone_block
close s set -2 2 1 minecraft:redstone_block
close s set 4 0 1 minecraft:redstone_block
close s set 4 1 1 minecraft:redstone_block
close s set 4 2 1 minecraft:redstone_block
close uu set 1 -2 1 minecraft:redstone_block
close z+pt set 3 3 1 minecraft:redstone_block
close z set 1 4 -1 minecraft:redstone_block
close z+2 clear 1 4 -1
close z+b1 set 1 5 -1 minecraft:redstone_block
close z+b1+2 clear 1 5 -1
close z+a2 set 1 3 -1 minecraft:redstone_block
close z+a2+2 clear 1 3 -1
close z+b2 set 1 5 -1 minecraft:redstone_block
close z+b2+2 clear 1 5 -1
close z+a3 set 1 4 -1 minecraft:redstone_block
close z+a3+2 clear 1 4 -1
