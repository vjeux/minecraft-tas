# m69g.ideal = m69f.ideal with the top trio driven by the LEVER (use at t0 of each edge) instead of pulses:
# lever ON at rest holds (0..2,4) extended; off pulls TL TM TR up, on pushes them back.
design designs/piston-door-3x3/tracks/w86/m69t/m69g.txt
phase tile
open 0 use 1 5 0
# left: U1 (ML west), QC-fires U0 (BL west)
open 2 set -2 1 -1 minecraft:redstone_block
open 6 clear -2 1 -1
# right: s1 (MR east), QC-fires s0 (BR east)
open 2 set 4 1 -1 minecraft:redstone_block
open 6 clear 4 1 -1
# corners pull ML / MR up the walls
open 8 set 3 3 -1 minecraft:redstone_block
open 12 clear 3 3 -1
open 8 set -1 3 -1 minecraft:redstone_block
open 12 clear -1 3 -1
# W' pushes BR up to (3,1)
open 14 set 3 -1 -1 minecraft:redstone_block
open 16 clear 3 -1 -1
# elevators [18,30): MB carries U1 into (-1,1), M0 carries s0 into (3,0); carried pulls at 22
open 18 set -3 1 -1 minecraft:redstone_block
open 18 set 5 0 -1 minecraft:redstone_block
open 22 set -1 1 -1 minecraft:redstone_block
open 26 clear -1 1 -1
open 22 set 3 0 -1 minecraft:redstone_block
open 26 clear 3 0 -1
open 30 clear -3 1 -1
open 30 clear 5 0 -1
# home pulls: U1 long (QC-fires U0: push BL out and pull it back), s0
open 34 set -2 1 -1 minecraft:redstone_block
open 40 clear -2 1 -1
open 34 set 4 0 -1 minecraft:redstone_block
open 38 clear 4 0 -1
# close
close 0 use 1 5 0
# s1 spits BR (3,1) -> (2,1); QC-coupled s0 spits BM (3,0) -> (2,0)
close 2 set 4 1 -1 minecraft:redstone_block
close 4 clear 4 1 -1
# MB pushes the line U1 + C (C -> (0,1)) and U1 spits C home at 12 (no carried s0 power on close)
close 8 set -3 1 -1 minecraft:redstone_block
close 12 set -1 1 -1 minecraft:redstone_block
close 14 clear -1 1 -1
close 18 clear -3 1 -1
# corners push ML / MR back down
close 20 set -1 3 -1 minecraft:redstone_block
close 22 clear -1 3 -1
close 20 set 3 3 -1 minecraft:redstone_block
close 22 clear 3 3 -1
# U1 spits ML home (QC-coupled U0 spits BL home); W' pulls MR down into (3,0)
close 26 set -2 1 -1 minecraft:redstone_block
close 28 clear -2 1 -1
close 26 set 3 -1 -1 minecraft:redstone_block
close 30 clear 3 -1 -1
# M0 pushes the line s0 + MR + BM (MR -> (2,0), BM -> (1,0)) and pulls s0 back
close 34 set 5 0 -1 minecraft:redstone_block
close 40 clear 5 0 -1
