# m79.ideal: lever flip + ideal inputs (redstone blocks at z = -1 behind the piston's current cell).
# QC couplings used on purpose: MB1 (-3,1) over MB0 (-3,0); U1 (-2,1) over U0 (-2,0); carried U1 (-1,1) over
# carried U0 (-1,0); s1 (4,1) over RP0 (4,0).
design designs/piston-door-3x3/tracks/w86/m69t/m79.txt
phase between
open 0 use 1 5 0
# U1 pulls ML to (-1,1) (QC: U0 pulls BL to (-1,0)); P3b' lifts ML to (-1,2)
open 2 set -2 1 -1 minecraft:redstone_block
open 4 clear -2 1 -1
open 8 set -1 3 -1 minecraft:redstone_block
open 10 clear -1 3 -1
