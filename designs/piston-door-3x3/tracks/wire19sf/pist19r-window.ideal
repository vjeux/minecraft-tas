# pist19r (mech-synth's 19-block slime-free mechanism) driven like a wired door: the SAME times on
# both lever edges, every piston fired by one 2 gt pulse (a redstone block set, cleared 2 gt later).
# Mechanism: door 9; left column on 3 pull-type sticky pistons (-2,0..2,0) facing east; right
# column on 3 (4,0..2,0) facing west; M on (1,-2,0) facing up; A (1,4,0) and B (1,5,0) facing
# down (elevator); P_T (-1,3,0) facing east (pulls T to (0,3,0)).
design designs/piston-door-3x3/tracks/wire19sf/pist19r-mech.txt
let a1 = 0     # A pulse 1 (A high): open lifts T to (1,3), close spits C down to (1,2)
let pt = 6     # P_T pulse: open pulls T to (0,3), close pushes it back to (1,3)
let b1 = 12    # B pulse 1: pushes A down to (1,3) (close: A, T, C down one)
let a2 = 18    # A pulse 2 (A low): open pulls C to (1,2), close spits T, C one further down
let b2 = 24    # B pulse 2: pulls A back up to (1,4)
let a3 = 30    # A pulse 3 (A high): open pulls C to (1,3), close no-op
let pl = 30    # left column (3 pistons)
let m = 36     # M: open pulls M down, close pushes M, C, T back up
let pr = 36    # right column (3 pistons)
open a1 set 2 4 0 minecraft:redstone_block
open a1+2 clear 2 4 0
close a1 set 2 4 0 minecraft:redstone_block
close a1+2 clear 2 4 0
open pt set -1 4 0 minecraft:redstone_block
open pt+2 clear -1 4 0
close pt set -1 4 0 minecraft:redstone_block
close pt+2 clear -1 4 0
open b1 set 2 5 0 minecraft:redstone_block
open b1+2 clear 2 5 0
close b1 set 2 5 0 minecraft:redstone_block
close b1+2 clear 2 5 0
open a2 set 2 3 0 minecraft:redstone_block
open a2+2 clear 2 3 0
close a2 set 2 3 0 minecraft:redstone_block
close a2+2 clear 2 3 0
open b2 set 2 5 0 minecraft:redstone_block
open b2+2 clear 2 5 0
close b2 set 2 5 0 minecraft:redstone_block
close b2+2 clear 2 5 0
open a3 set 2 4 0 minecraft:redstone_block
open a3+2 clear 2 4 0
close a3 set 2 4 0 minecraft:redstone_block
close a3+2 clear 2 4 0
open pl set -2 -1 0 minecraft:redstone_block
open pl set -3 1 0 minecraft:redstone_block
open pl set -3 2 0 minecraft:redstone_block
open pl+2 clear -2 -1 0
open pl+2 clear -3 1 0
open pl+2 clear -3 2 0
close pl set -2 -1 0 minecraft:redstone_block
close pl set -3 1 0 minecraft:redstone_block
close pl set -3 2 0 minecraft:redstone_block
close pl+2 clear -2 -1 0
close pl+2 clear -3 1 0
close pl+2 clear -3 2 0
open m set 1 -3 0 minecraft:redstone_block
open m+2 clear 1 -3 0
close m set 1 -3 0 minecraft:redstone_block
close m+2 clear 1 -3 0
open pr set 4 -1 0 minecraft:redstone_block
open pr set 5 1 0 minecraft:redstone_block
open pr set 5 2 0 minecraft:redstone_block
open pr+2 clear 4 -1 0
open pr+2 clear 5 1 0
open pr+2 clear 5 2 0
close pr set 4 -1 0 minecraft:redstone_block
close pr set 5 1 0 minecraft:redstone_block
close pr set 5 2 0 minecraft:redstone_block
close pr+2 clear 4 -1 0
close pr+2 clear 5 1 0
close pr+2 clear 5 2 0
