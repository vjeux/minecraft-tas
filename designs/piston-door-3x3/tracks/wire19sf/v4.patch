# v4: like v3 but the TR puller is fired late by a 3-observer chain off the P_T chain's end
# (t14), so the right pair fires at t18 and O_m (watching BR) fires M at t22.
clear 4 2 0
set 4 2 0 minecraft:smooth_stone
set 2 4 0 minecraft:sticky_piston[extended=false,facing=down]
set 3 2 0 minecraft:observer[facing=west,powered=false]
set -2 4 -1 minecraft:observer[facing=east,powered=false]
set -2 3 -1 minecraft:observer[facing=up,powered=false]
set -2 2 -1 minecraft:redstone_wire[east=side,north=side,power=0,south=side,west=side]
set -2 1 -1 minecraft:smooth_stone
set 2 -1 0 minecraft:observer[facing=up,powered=false]
set 2 -2 0 minecraft:smooth_stone
