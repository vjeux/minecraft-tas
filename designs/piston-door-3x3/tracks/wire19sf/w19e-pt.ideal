# w19-pt: real lever, s7q's north cluster and a 4-observer chain into P_T's quasi cell
# (lever -> (0,4,-3) -> (-1,4,-3) -> (-1,4,-2) -> (-1,4,-1) -> air (-1,4,0), t8); the side
# columns and M by ideal inputs.
design designs/piston-door-3x3/tracks/wire19sf/w19e-pt.txt
let pl = 5
let pr = 5
let m = 21
open 0 use 1 4 -3
close 0 use 1 4 -3
open pl set -2 -1 0 minecraft:redstone_block
open pl set -3 1 0 minecraft:redstone_block
open pl set -3 2 0 minecraft:redstone_block
open pl+2 clear -2 -1 0
open pl+2 clear -3 1 0
open pl+2 clear -3 2 0
close pl set -2 -1 0 minecraft:redstone_block
close pl set -3 1 0 minecraft:redstone_block
close pl set -3 2 0 minecraft:redstone_block
close pl+2 clear -2 -1 0
close pl+2 clear -3 1 0
close pl+2 clear -3 2 0
open m set 1 -3 0 minecraft:redstone_block
open m+2 clear 1 -3 0
close m set 1 -3 0 minecraft:redstone_block
close m+2 clear 1 -3 0
open pr set 4 -1 0 minecraft:redstone_block
open pr set 5 1 0 minecraft:redstone_block
open pr set 5 2 0 minecraft:redstone_block
open pr+2 clear 4 -1 0
open pr+2 clear 5 1 0
open pr+2 clear 5 2 0
close pr set 4 -1 0 minecraft:redstone_block
close pr set 5 1 0 minecraft:redstone_block
close pr set 5 2 0 minecraft:redstone_block
close pr+2 clear 4 -1 0
close pr+2 clear 5 1 0
close pr+2 clear 5 2 0
