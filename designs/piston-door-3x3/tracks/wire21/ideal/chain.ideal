# abpt21r driven in "chain ticks": a variable = the tick an observer chain would turn on
# (observer k of a chain watching the lever turns on at 2k). An observer turning on at tick T
# acts like a redstone block set at T-1 (the piston's block event runs in tick T) and cleared
# at T+1. B is one level window [bon, boff) (a repeater), the rest are 2 gt pulses.
design designs/piston-door-3x3/tracks/wire21/ideal/mech.txt
let pl = 4      # P_L pulse (left column), any time
let a1 = 2      # A pulse 1: open lifts T, close spits C down
let pt = 6      # P_T pulse: open pushes T to (2,3), close pulls it back
let bon = 12    # B on (window): open pushes A down, close pushes A,T,C down
let boff = 20   # B off: B pulls A back up
let a2 = 14     # A pulse 2 (A down): open pulls C to (1,2), close spits T,C down
let a3 = 22     # A pulse 3: open pulls C to (1,3), close no-op
let m = 24      # M pulse: open pulls M down, close pushes M,C,T back up
let pr = 24     # P_R pulse (right column), any time
open pl-1 set -4 1 0 minecraft:redstone_block
open pl+1 clear -4 1 0
close pl-1 set -4 1 0 minecraft:redstone_block
close pl+1 clear -4 1 0
open a1-1 set 2 4 0 minecraft:redstone_block
open a1+1 clear 2 4 0
close a1-1 set 2 4 0 minecraft:redstone_block
close a1+1 clear 2 4 0
open pt-1 set 0 3 1 minecraft:redstone_block
open pt+1 clear 0 3 1
close pt-1 set 0 3 1 minecraft:redstone_block
close pt+1 clear 0 3 1
open bon-1 set 2 5 0 minecraft:redstone_block
open boff-1 clear 2 5 0
close bon-1 set 2 5 0 minecraft:redstone_block
close boff-1 clear 2 5 0
open a2-1 set 1 3 1 minecraft:redstone_block
open a2+1 clear 1 3 1
close a2-1 set 1 3 1 minecraft:redstone_block
close a2+1 clear 1 3 1
open a3-1 set 2 4 0 minecraft:redstone_block
open a3+1 clear 2 4 0
close a3-1 set 2 4 0 minecraft:redstone_block
close a3+1 clear 2 4 0
open m-1 set 1 -3 0 minecraft:redstone_block
open m+1 clear 1 -3 0
close m-1 set 1 -3 0 minecraft:redstone_block
close m+1 clear 1 -3 0
open pr-1 set 6 1 0 minecraft:redstone_block
open pr+1 clear 6 1 0
close pr-1 set 6 1 0 minecraft:redstone_block
close pr+1 clear 6 1 0
