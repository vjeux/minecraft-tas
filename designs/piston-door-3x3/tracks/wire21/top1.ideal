# top1: real lever + top control (A, B, P_T, P_L); ideal pulses for M and P_R (chain ticks)
design designs/piston-door-3x3/tracks/wire21/top1.txt
let m = 24
let pr = 24
open 0 use -2 4 0
close 0 use -2 4 0
open m-1 set 1 -3 0 minecraft:redstone_block
