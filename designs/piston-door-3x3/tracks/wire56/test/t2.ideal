# wire56 t2: t1 with every K2 timing as a variable (for sweeps). K2 (controller) emulated by
# redstone blocks one cell behind the plane (z=1); K1/K0/K3 are real (t1.txt).
# An observer pulse [T, T+2) is emulated by `set` at T-1 and `clear` at T+1.
design designs/piston-door-3x3/tracks/wire56/test/t1.txt
let a = 4
let s2 = 8
let s3 = 12
let s4 = 14
let s5 = 18
let s6 = 24
let r = 30
let g = 6
let w5 = 2
# P4 (1,4): s1, s6; lifted P4 (1,3): s4 (behind (1,3))
open a-1 set 1 4 1 minecraft:redstone_block
open a+1 clear 1 4 1
open s4-1 set 1 3 1 minecraft:redstone_block
open s4+1 clear 1 3 1
open s6-1 set 1 4 1 minecraft:redstone_block
open s6+1 clear 1 4 1
close a-1 set 1 4 1 minecraft:redstone_block
close a+1 clear 1 4 1
close s4-1 set 1 3 1 minecraft:redstone_block
close s4+1 clear 1 3 1
close s6-1 set 1 4 1 minecraft:redstone_block
close s6+1 clear 1 4 1
# PT (3,3): s2
open s2-1 set 3 3 1 minecraft:redstone_block
open s2+1 clear 3 3 1
close s2-1 set 3 3 1 minecraft:redstone_block
close s2+1 clear 3 3 1
# P5 (1,5): s3 (2 gt), s5 (w5 gt)
open s3-1 set 1 5 1 minecraft:redstone_block
open s3+1 clear 1 5 1
open s5-1 set 1 5 1 minecraft:redstone_block
open s5-1+w5 clear 1 5 1
close s3-1 set 1 5 1 minecraft:redstone_block
close s3+1 clear 1 5 1
close s5-1 set 1 5 1 minecraft:redstone_block
close s5-1+w5 clear 1 5 1
# PTR (4,2) + PMR (4,1) together: 3 pulses g gt apart
open r-1 set 4 2 1 minecraft:redstone_block
open r-1 set 4 1 1 minecraft:redstone_block
open r+1 clear 4 2 1
open r+1 clear 4 1 1
open r+g-1 set 4 2 1 minecraft:redstone_block
open r+g-1 set 4 1 1 minecraft:redstone_block
open r+g+1 clear 4 2 1
open r+g+1 clear 4 1 1
open r+g+g-1 set 4 2 1 minecraft:redstone_block
open r+g+g-1 set 4 1 1 minecraft:redstone_block
open r+g+g+1 clear 4 2 1
open r+g+g+1 clear 4 1 1
close r-1 set 4 2 1 minecraft:redstone_block
close r-1 set 4 1 1 minecraft:redstone_block
close r+1 clear 4 2 1
close r+1 clear 4 1 1
close r+g-1 set 4 2 1 minecraft:redstone_block
close r+g-1 set 4 1 1 minecraft:redstone_block
close r+g+1 clear 4 2 1
close r+g+1 clear 4 1 1
close r+g+g-1 set 4 2 1 minecraft:redstone_block
close r+g+g-1 set 4 1 1 minecraft:redstone_block
close r+g+g+1 clear 4 2 1
close r+g+g+1 clear 4 1 1
