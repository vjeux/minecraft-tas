# wire64: families 8x8-102 driven by the SAME train on both edges, E3 as one WINDOW (not two pulses):
# s1 L1 (rest) pulse, PD level at lv, E3 held [s3,s5) (push L1 up, hold, pull it back), the lifted L1
# pulsed once at s4 (after it landed), s6 L1 (rest) pulse, 7 toggles. Ideal inputs are redstone blocks
# BEHIND the plane (z=1) so each one powers exactly one piston; L1 at rest and PD are fed through their
# quasi cells (a direct input to L1 would quasi-power L0 below it) and poked with glass for the update.
design designs/piston-door-3x3/tracks/wire64/ideal/w102-mech.txt
let s1 = 2
let lv = 8
let s3 = 12
let s4 = 14
let s5 = 20
let s6 = 24
let tg = 28
open s1 set -2 2 1 minecraft:redstone_block
open s1 set -2 1 1 minecraft:glass
open s1 clear -2 1 1
open s1+2 clear -2 2 1
open s1+2 set -2 1 1 minecraft:glass
open s1+2 clear -2 1 1
open lv clear -1 4 1
open lv set -1 3 1 minecraft:glass
open lv clear -1 3 1
open s3 set -3 1 1 minecraft:redstone_block
open s4 set -1 1 1 minecraft:redstone_block
open s4+2 clear -1 1 1
open s5 clear -3 1 1
open s6 set -2 2 1 minecraft:redstone_block
open s6 set -2 1 1 minecraft:glass
open s6 clear -2 1 1
open s6+2 clear -2 2 1
open s6+2 set -2 1 1 minecraft:glass
open s6+2 clear -2 1 1
open tg set -2 0 1 minecraft:redstone_block
open tg set 0 4 1 minecraft:redstone_block
open tg set 1 4 1 minecraft:redstone_block
open tg set 2 4 1 minecraft:redstone_block
open tg set 1 -2 1 minecraft:redstone_block
open tg set 2 -2 1 minecraft:redstone_block
open tg set 4 1 1 minecraft:redstone_block
open tg+2 clear -2 0 1
open tg+2 clear 0 4 1
open tg+2 clear 1 4 1
open tg+2 clear 2 4 1
open tg+2 clear 1 -2 1
open tg+2 clear 2 -2 1
open tg+2 clear 4 1 1
close s1 set -2 2 1 minecraft:redstone_block
close s1 set -2 1 1 minecraft:glass
close s1 clear -2 1 1
close s1+2 clear -2 2 1
close s1+2 set -2 1 1 minecraft:glass
close s1+2 clear -2 1 1
close lv set -1 4 1 minecraft:redstone_block
close lv set -1 3 1 minecraft:glass
close lv clear -1 3 1
close s3 set -3 1 1 minecraft:redstone_block
close s4 set -1 1 1 minecraft:redstone_block
close s4+2 clear -1 1 1
close s5 clear -3 1 1
close s6 set -2 2 1 minecraft:redstone_block
close s6 set -2 1 1 minecraft:glass
close s6 clear -2 1 1
close s6+2 clear -2 2 1
close s6+2 set -2 1 1 minecraft:glass
close s6+2 clear -2 1 1
close tg set -2 0 1 minecraft:redstone_block
close tg set 0 4 1 minecraft:redstone_block
close tg set 1 4 1 minecraft:redstone_block
close tg set 2 4 1 minecraft:redstone_block
close tg set 1 -2 1 minecraft:redstone_block
close tg set 2 -2 1 minecraft:redstone_block
close tg set 4 1 1 minecraft:redstone_block
close tg+2 clear -2 0 1
close tg+2 clear 0 4 1
close tg+2 clear 1 4 1
close tg+2 clear 2 4 1
close tg+2 clear 1 -2 1
close tg+2 clear 2 -2 1
close tg+2 clear 4 1 1
