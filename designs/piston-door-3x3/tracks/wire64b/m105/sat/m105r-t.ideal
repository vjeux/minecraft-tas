# m105r (8x8-105 with a pulse-driven T parker) on families' ideal feed cells (their sym plan
# WORKS at 32 positions), timing parameterized for `door satwire --grid`: A1 at 0 (block behind A),
# L + P2 + P1 at tl (one block at (-2,3): beside L, above P2, P1 by quasi-connectivity), B1 = tl+db (block at (0,5)),
# A2 = B1+da (block behind A at (1,3)), B2 = B1+dbb, A3 = B2+da3, the right side (R, P3, P4: the
# memory link watching B) at B1+dk, Q dq after A3 (on close Q must come after A3), P0 dp after Q
# (K0 watching Q). Every pulse lasts 2 ticks. Defaults: a working compact timing.
design designs/piston-door-3x3/tracks/wire64b/m105/ideal/m105r-pure-sym.txt
let tl = 5
let db = 3
let da = 4
let dbb = 8
let da3 = 4
let dk = 8
let dq = 2
let dp = 4
open 0 set 1 4 1 minecraft:redstone_block
open 2 clear 1 4 1
open tl set -2 3 0 minecraft:redstone_block
open tl+2 clear -2 3 0
open tl+db set 0 5 0 minecraft:redstone_block
open tl+db+2 clear 0 5 0
open tl+db+da set 1 3 1 minecraft:redstone_block
open tl+db+da+2 clear 1 3 1
open tl+db+dbb set 0 5 0 minecraft:redstone_block
open tl+db+dbb+2 clear 0 5 0
open tl+db+dbb+da3 set 1 4 1 minecraft:redstone_block
open tl+db+dbb+da3+2 clear 1 4 1
open tl+db+dk set 3 4 0 minecraft:redstone_block
open tl+db+dk set 4 -1 0 minecraft:redstone_block
open tl+db+dk set 5 1 0 minecraft:redstone_block
open tl+db+dk+2 clear 3 4 0
open tl+db+dk+2 clear 4 -1 0
open tl+db+dk+2 clear 5 1 0
open tl+db+dbb+da3+dq set 1 -3 0 minecraft:redstone_block
open tl+db+dbb+da3+dq+2 clear 1 -3 0
open tl+db+dbb+da3+dq+dp set -2 -1 0 minecraft:redstone_block
open tl+db+dbb+da3+dq+dp+2 clear -2 -1 0
close 0 set 1 4 1 minecraft:redstone_block
close 2 clear 1 4 1
close tl set -2 3 0 minecraft:redstone_block
close tl+2 clear -2 3 0
close tl+db set 0 5 0 minecraft:redstone_block
close tl+db+2 clear 0 5 0
close tl+db+da set 1 3 1 minecraft:redstone_block
close tl+db+da+2 clear 1 3 1
close tl+db+dbb set 0 5 0 minecraft:redstone_block
close tl+db+dbb+2 clear 0 5 0
close tl+db+dbb+da3 set 1 4 1 minecraft:redstone_block
close tl+db+dbb+da3+2 clear 1 4 1
close tl+db+dk set 3 4 0 minecraft:redstone_block
close tl+db+dk set 4 -1 0 minecraft:redstone_block
close tl+db+dk set 5 1 0 minecraft:redstone_block
close tl+db+dk+2 clear 3 4 0
close tl+db+dk+2 clear 4 -1 0
close tl+db+dk+2 clear 5 1 0
close tl+db+dbb+da3+dq set 1 -3 0 minecraft:redstone_block
close tl+db+dbb+da3+dq+2 clear 1 -3 0
close tl+db+dbb+da3+dq+dp set -2 -1 0 minecraft:redstone_block
close tl+db+dbb+da3+dq+dp+2 clear -2 -1 0
