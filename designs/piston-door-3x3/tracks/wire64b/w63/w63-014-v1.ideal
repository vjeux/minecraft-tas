# 7x8-014 bottom pockets wired for real (w63-014-bottom.txt), the top by ideal inputs: families'
# sym timing for A, the T parker, B, TL; the left stack (P1 direct + P0 by QC from (-2,2)) and the
# right stack (P5 direct + P4 by QC from behind P5, (4,2,1): a redstone block at (4,3) would also
# power P_T beside it) fired 3 times g ticks apart from t0 / tr (the watchers below then see an odd
# number of pulses through the observer busy window). Every top event is a variable, for sweeps.
design designs/piston-door-3x3/tracks/wire64b/w63/w63-014-bottom.txt
let a1 = 0
let pt = 6
let b1 = 12
let a2 = 18
let b2 = 24
let a3 = 30
let u = 0
let t0 = 30
let g = 6
let tr = 0
open a1 set 1 4 1 minecraft:redstone_block
open a1+2 clear 1 4 1
open pt set 3 4 0 minecraft:redstone_block
open pt+2 clear 3 4 0
open b1 set 2 5 0 minecraft:redstone_block
open b1+2 clear 2 5 0
open a2 set 1 3 1 minecraft:redstone_block
open a2+2 clear 1 3 1
open b2 set 2 5 0 minecraft:redstone_block
open b2+2 clear 2 5 0
open a3 set 1 4 1 minecraft:redstone_block
open a3+2 clear 1 4 1
open u set -1 4 0 minecraft:redstone_block
open u+2 clear -1 4 0
open t0 set -2 2 0 minecraft:redstone_block
open t0+2 clear -2 2 0
open t0+g set -2 2 0 minecraft:redstone_block
open t0+g+2 clear -2 2 0
open t0+g+g set -2 2 0 minecraft:redstone_block
open t0+g+g+2 clear -2 2 0
open tr set 4 2 1 minecraft:redstone_block
open tr+2 clear 4 2 1
open tr+g set 4 2 1 minecraft:redstone_block
open tr+g+2 clear 4 2 1
open tr+g+g set 4 2 1 minecraft:redstone_block
open tr+g+g+2 clear 4 2 1
close a1 set 1 4 1 minecraft:redstone_block
close a1+2 clear 1 4 1
close pt set 3 4 0 minecraft:redstone_block
close pt+2 clear 3 4 0
close b1 set 2 5 0 minecraft:redstone_block
close b1+2 clear 2 5 0
close a2 set 1 3 1 minecraft:redstone_block
close a2+2 clear 1 3 1
close b2 set 2 5 0 minecraft:redstone_block
close b2+2 clear 2 5 0
close a3 set 1 4 1 minecraft:redstone_block
close a3+2 clear 1 4 1
close u set -1 4 0 minecraft:redstone_block
close u+2 clear -1 4 0
close t0 set -2 2 0 minecraft:redstone_block
close t0+2 clear -2 2 0
close t0+g set -2 2 0 minecraft:redstone_block
close t0+g+2 clear -2 2 0
close t0+g+g set -2 2 0 minecraft:redstone_block
close t0+g+g+2 clear -2 2 0
close tr set 4 2 1 minecraft:redstone_block
close tr+2 clear 4 2 1
close tr+g set 4 2 1 minecraft:redstone_block
close tr+g+2 clear 4 2 1
close tr+g+g set 4 2 1 minecraft:redstone_block
close tr+g+g+2 clear 4 2 1
